amends "..."

import ".../common.pkl"
import "@talos/network/LinkAliasConfigV1Alpha1.pkl" as LinkAliasConfig
import "@talos/network/LinkConfigV1Alpha1.pkl" as LinkConfig
import "@talos/network/StaticHostConfigV1Alpha1.pkl" as StaticHostConfig
import "@talos/network/DHCPv4ConfigV1Alpha1.pkl" as DHCPv4Config

allowScheduling = true

diskSelector = "disk.dev_path == \"/dev/sda\""

vipLink = "net0"

schematic {
  customization {
    systemExtensions {
      officialExtensions {
        "siderolabs/qemu-guest-agent"
      }
    }
  }
}

documents {
  (LinkAliasConfig) {
    name = "net0"
    selector {
      match = "mac(link.permanent_addr) == \"bc:24:11:4a:1e:41\""
    }
  }
  (LinkConfig) {
    name = "net0"
  }
  (DHCPv4Config) {
    name = "net0"
  }
  (LinkAliasConfig) {
    name = "vnet0"
    selector {
      match = "mac(link.permanent_addr) == \"bc:24:11:8e:f2:8b\""
    }
  }
  (LinkConfig) {
    name = "vnet0"
    mtu = 9000
    addresses {
      new {
        address = "10.0.10.2/24"
      }
    }
  }
  (StaticHostConfig) {
    name = "10.0.10.1"
    hostnames {
      common.nasDomain
    }
  }
}
