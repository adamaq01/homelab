/// The secrets bundle shape produced by `talosctl gen secrets`, mirroring
/// `github.com/siderolabs/talos/pkg/machinery/config/generate/secrets.Bundle`.
open module common.SecretsBundle

import "PEMCertificateAndKey.pkl"
import "PEMEncodedKey.pkl"

cluster: Cluster

secrets: Secrets

trustdinfo: TrustdInfo

certs: Certs

class Cluster {
  id: String

  secret: String
}

class Secrets {
  bootstraptoken: String

  secretboxencryptionsecret: String

  aescbcencryptionsecret: String?
}

class TrustdInfo {
  token: String
}

class Certs {
  etcd: PEMCertificateAndKey

  k8s: PEMCertificateAndKey

  k8saggregator: PEMCertificateAndKey

  k8sserviceaccount: PEMEncodedKey

  os: PEMCertificateAndKey
}
