/// Loads a talosctl YAML secrets bundle into a typed [SecretsBundle], instead of hand-transcribing PEM/token
/// values into every document that needs one.
module talos.secrets

import "pkl:yaml"
import "@deepToTyped/deepToTyped.pkl"
import "common/SecretsBundle.pkl"

path: String = "secrets.sample.yaml"

bundle: SecretsBundle = deepToTyped.apply(SecretsBundle.getClass(), (new yaml.Parser {}).parse(read(path).text)) as SecretsBundle
