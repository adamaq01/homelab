amends "@manifest/generate.pkl"

import "@gateway-api/HTTPRoute.pkl"
import "@traefik-crds/Middleware.pkl"
import "app.pkl"
import "../traefik/app.pkl" as traefik

// renovate: datasource=github-releases packageName=argoproj/argo-cd
local version = "v3.5.2"

source = "https://raw.githubusercontent.com/argoproj/argo-cd/\(version)/manifests/install.yaml"

patches = import*("patches/*.pkl")

local httpRoute: HTTPRoute = new {
  metadata {
    name = "argocd-server"
  }
  spec {
    parentRefs {
      new {
        name = traefik.gatewayName
        namespace = traefik.namespace
        sectionName = "websecure"
      }
    }
    hostnames {
      "argocd.\(app.ingressDomain)"
      "argocd.\(app.ingressAliasDomain)"
    }
    rules {
      new {
        backendRefs {
          new {
            name = "argocd-server"
            port = 80
          }
        }
      }
    }
  }
}

local webhookHttpRoute: HTTPRoute = new {
  metadata {
    name = "argocd-server-webhook"
  }
  spec {
    parentRefs {
      new {
        name = traefik.gatewayName
        namespace = traefik.namespace
        sectionName = "websecure"
      }
    }
    hostnames {
      app.publicGatewayHostname
    }
    rules {
      new {
        matches {
          new {
            path {
              type = "Exact"
              value = "/argocd/api/webhook"
            }
          }
        }
        filters {
          new {
            type = "ExtensionRef"
            extensionRef {
              group = "traefik.io"
              kind = "Middleware"
              name = argocdWebhookStripPrefix.metadata.name!!
            }
          }
        }
        backendRefs {
          new {
            name = "argocd-server"
            port = 80
          }
        }
      }
    }
  }
}

local argocdWebhookStripPrefix: Middleware = new {
  metadata {
    name = "argocd-webhook-strip-prefix"
  }
  spec {
    stripPrefix {
      prefixes {
        "/argocd"
      }
    }
  }
}

value {
  httpRoute
  webhookHttpRoute
  argocdWebhookStripPrefix
}
