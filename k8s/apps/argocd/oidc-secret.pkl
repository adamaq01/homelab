/// The OIDC client secret ArgoCD needs for `patches/configmap-argocd-cm.pkl`'s `oidc.config`,
/// sourced from OpenBao rather than inlined into that ConfigMap.
///
/// This reads the same `secret/voidauth` OpenBao path VoidAuth's own Deployment reads.
/// ArgoCD resolves `$<secret-name>:<key>`-style references in `argocd-cm` against any Secret in
/// its own namespace, but only reloads config live off ones carrying the same
/// `app.kubernetes.io/part-of: argocd` label it requires of its ConfigMaps, hence the
/// `target.template` override below, since the reusable `ExternalSecret` helper doesn't expose it.
module oidcSecret

import ".../utils/ExternalSecret.pkl"

resource = (new ExternalSecret {
  name = "argocd-voidauth-oidc"
  secrets {
    ["voidauth"] {
      "client-secret"
    }
  }
}.resource) {
  spec {
    target {
      template {
        metadata {
          labels {
            ["app.kubernetes.io/part-of"] = "argocd"
          }
        }
      }
    }
  }
}
