/// The OIDC client ID/secret ArgoCD needs for `patches/configmap-argocd-cm.pkl`'s `oidc.config`,
/// sourced from OpenBao rather than inlined into that ConfigMap (see
/// <https://argo-cd.readthedocs.io/en/stable/operator-manual/user-management/zitadel/#argocd-cmyaml>).
/// The client ID isn't itself sensitive, but keeping it alongside the secret here means both come
/// from the one place set up when the Zitadel OIDC application was created, rather than half living
/// in Git. ArgoCD resolves `$<secret-name>:<key>`-style references in `argocd-cm` against any
/// Secret in its own namespace, but only reloads config live off ones carrying the same
/// `app.kubernetes.io/part-of: argocd` label it requires of its ConfigMaps — hence the
/// `target.template` override below, since the reusable `ExternalSecret` helper doesn't expose it.
///
/// Seed with (once the Zitadel OIDC client — see the linked doc — exists):
///
///    kubectl exec -i -n secrets openbao-0 -- bao kv put secret/argocd \
///      zitadel-client-id=<client ID> \
///      zitadel-client-secret=<client secret>
module oidcSecret

import ".../utils/ExternalSecret.pkl"

resource = (new ExternalSecret {
  name = "argocd-zitadel-oidc"
  secrets {
    ["argocd"] {
      "zitadel-client-id"
      "zitadel-client-secret"
    }
  }
}.resource) {
  spec {
    target {
      template {
        metadata {
          labels {
            ["app.kubernetes.io/part-of"] = "argocd"
          }
        }
      }
    }
  }
}
