/// The GitHub webhook endpoint (`argocd-server-webhook` HTTPRoute, see `chart.pkl`) has no rate
/// limiting of its own, so this caps the request body ArgoCD will read from it to bound abuse via
/// oversized payloads. GitHub's push payloads are ordinarily well under this.
amends "@manifest/Patch.pkl"

import "@k8s/api/core/v1/ConfigMap.pkl"
import ".../app.pkl"

patch = new Mixin<ConfigMap> {
  data = new Mapping {
    ["admin.enabled"] = "false"
    ["url"] = "https://\(app.primaryHostname)"
    ["additionalUrls"] = """
      - https://\(app.aliasHostname)
      """
    ["webhook.maxPayloadSizeMB"] = "1"
    ["oidc.config"] = """
      name: Zitadel
      issuer: https://auth.\(app.rootDomain)
      clientID: $argocd-zitadel-oidc:zitadel-client-id
      clientSecret: $argocd-zitadel-oidc:zitadel-client-secret
      requestedScopes:
        - openid
        - profile
        - email
      logoutURL: https://auth.\(app.rootDomain)/oidc/v1/end_session
      """
  }
}
