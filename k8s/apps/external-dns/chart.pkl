/// The same underlying Cloudflare API token as `../cert-manager/chart.pkl`'s
/// `cloudflareApiTokenExternalSecret`, fetched again here since ExternalSecret output is
/// namespace-scoped and this instance runs in its own `external-dns` namespace.
amends "../../utils/ExternalSecret.pkl"

name = "cloudflare-api-token-secret"
secrets {
  ["cloudflare"] {
    "api-token"
  }
}
