extends ".../app.pkl"

import "../cert-manager/app.pkl" as cert_manager
import "@traefik/Values.pkl"

// renovate: datasource=helm packageName=traefik registryUrl=https://traefik.github.io/charts
local version = "41.4.0"

// Chart default, left unset in `valuesObject` below. Referenced cross-app by HTTPRoutes'
// `parentRefs` (e.g. `dozzle/chart.pkl`).
gatewayName: String = "traefik-gateway"

// The Gateway resource this chart creates (via `gateway.listeners`) ends up in this Application's
// own destination namespace, while cert-manager's wildcard Certificate/Secret for the domain
// lives in the `cert-manager` namespace. A ReferenceGrant there (see cert-manager's chart.pkl)
// authorizes each listener's `certificateRefs` to resolve it cross-namespace.
source {
  repoURL = "https://traefik.github.io/charts"
  chart = "traefik"
  targetRevision = version
  path = null
  helm {
    // `Values.Spec` (the vendored, generated wrapper for `service.spec`) only surfaces `type`,
    // since that's the one field the chart's own schema bothers to name explicitly even though
    // `service.spec` itself is documented as an open passthrough merged directly into the real
    // Service spec, a generated-file gap, not a real restriction, so reached via a plain Helm
    // `--set`-style parameter here instead of a `valuesObject` field.
    //
    // Needed because kube-proxy's default `externalTrafficPolicy: Cluster` SNATs every request
    // arriving via the LoadBalancer IP to a node IP before it reaches Traefik, so `IpAllowList`
    // middlewares (e.g. `headscale/chart.pkl`'s `headplaneAllowListMiddleware`) never see the real
    // client IP and reject everything regardless of its true origin. `Local` preserves it. Safe
    // with this Gateway's single replica: MetalLB (L2 mode) only announces the VIP from a node
    // with a ready local endpoint, so there's no dead-end routing risk from restricting to
    // node-local endpoints.
    parameters {
      new {
        name = "service.spec.externalTrafficPolicy"
        value = "Local"
      }
    }
    valuesObject =
      new Values {
        accessLog {
          enabled = true
        }
        // Redirects all plain HTTP traffic to HTTPS at the entrypoint level, so every app's
        // HTTPRoute only needs to target an HTTPS listener to get HTTP covered for free.
        ports {
          ["web"] {
            http {
              redirections {
                entryPoint {
                  to = "websecure"
                  scheme = "https"
                  permanent = true
                }
              }
            }
          }
        }
        providers {
          kubernetesGateway {
            enabled = true
          }
        }
        gateway {
          // external-dns only honors this on the Gateway itself, never on an HTTPRoute. Safe
          // despite the single listener below carrying both private and public hostnames:
          // external-dns's `annotationFilter` (see `external-dns/app.pkl`) excludes every route
          // that isn't explicitly public.
          annotations {
            ["external-dns.alpha.kubernetes.io/target"] = module.publicGatewayHostname
          }
          listeners {
            // Namespace-restricted by default in Gateway API, but every app's HTTPRoute lives in
            // its own namespace.
            //
            // One listener covers every hostname in the cluster: which apps are reachable from
            // where is entirely `HTTPRoute.hostnames`-driven, not listener-driven, so there's no
            // routing/access-control reason to split listeners. The only reason multiple
            // `certificateRefs` exist here is that a wildcard cert only covers one label of
            // subdomain depth (`*.\(module.rootDomain)` doesn't cover `*.\(module.ingressDomain)`),
            // so each hostname pattern in use needs its own cert; Traefik picks the right one
            // per-request via SNI.
            ["websecure"] {
              port = 8443
              protocol = "HTTPS"
              mode = "Terminate"
              namespacePolicy {
                from = "All"
              }
              certificateRefs {
                new {
                  name = cert_manager.ingressWildcardCertSecretName
                  namespace = cert_manager.namespace
                }
                new {
                  name = cert_manager.publicWildcardCertSecretName
                  namespace = cert_manager.namespace
                }
              }
            }
          }
        }
        service {
          annotations {
            ["metallb.io/loadBalancerIPs"] = module.gatewayIP
          }
        }
      }.toDynamic()
  }
}
