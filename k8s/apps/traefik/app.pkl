extends ".../app.pkl"

import "../cert-manager/app.pkl" as cert_manager
import "@traefik/Values.pkl"

// renovate: datasource=helm packageName=traefik registryUrl=https://traefik.github.io/charts
local version = "41.4.0"

// Chart default, left unset in `valuesObject` below. Referenced cross-app by HTTPRoutes'
// `parentRefs` (e.g. `dozzle/chart.pkl`).
gatewayName: String = "traefik-gateway"

// The Gateway resource this chart creates (via `gateway.listeners`) ends up in this Application's
// own destination namespace, while cert-manager's wildcard Certificate/Secret for the domain
// lives in the `cert-manager` namespace. A ReferenceGrant there (see cert-manager's chart.pkl)
// authorizes each listener's `certificateRefs` to resolve it cross-namespace.
source {
  repoURL = "https://traefik.github.io/charts"
  chart = "traefik"
  targetRevision = version
  path = null
  helm {
    valuesObject =
      new Values {
        // Redirects all plain HTTP traffic to HTTPS at the entrypoint level, so every app's
        // HTTPRoute only needs to target an HTTPS listener to get HTTP covered for free.
        ports {
          ["web"] {
            http {
              redirections {
                entryPoint {
                  to = ":443"
                  scheme = "https"
                  permanent = true
                }
              }
            }
          }
        }
        providers {
          kubernetesGateway {
            enabled = true
          }
        }
        gateway {
          // external-dns only honors this on the Gateway itself, never on an HTTPRoute. Safe
          // despite the LAN-only listeners sharing this Gateway: external-dns's `annotationFilter`
          // (see `external-dns/app.pkl`) excludes every route that isn't explicitly public.
          annotations {
            ["external-dns.alpha.kubernetes.io/target"] = module.publicGatewayHostname
          }
          listeners {
            // Namespace-restricted by default in Gateway API, but every app's HTTPRoute lives in
            // its own namespace.
            ["private"] {
              port = 8443
              protocol = "HTTPS"
              hostname = "*.\(module.ingressDomain)"
              mode = "Terminate"
              namespacePolicy {
                from = "All"
              }
              certificateRefs {
                new {
                  name = cert_manager.ingressWildcardCertSecretName
                  namespace = cert_manager.namespace
                }
              }
            }
            ["private-alias"] {
              port = 8443
              protocol = "HTTPS"
              hostname = "*.\(module.ingressAliasDomain)"
              mode = "Terminate"
              namespacePolicy {
                from = "All"
              }
              certificateRefs {
                new {
                  name = cert_manager.ingressWildcardCertSecretName
                  namespace = cert_manager.namespace
                }
              }
            }
            ["public"] {
              port = 8443
              protocol = "HTTPS"
              hostname = "*.\(module.rootDomain)"
              mode = "Terminate"
              namespacePolicy {
                from = "All"
              }
              certificateRefs {
                new {
                  name = cert_manager.publicWildcardCertSecretName
                  namespace = cert_manager.namespace
                }
              }
            }
          }
        }
        service {
          annotations {
            ["metallb.io/loadBalancerIPs"] = module.gatewayIP
          }
        }
      }.toDynamic()
  }
}
