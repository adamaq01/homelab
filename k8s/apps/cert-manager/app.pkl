extends ".../app.pkl"

/// Secret the `domain` wildcard Certificate (see chart.pkl) is stored in. Covers the LAN's literal
/// hosts, not Kubernetes ingress.
wildcardCertSecretName: String = "home-adamaq01-fr-tls"

/// Secret the `ingressDomain` wildcard Certificate (see chart.pkl) is stored in, referenced cross-app
/// by Traefik's Gateway private listener.
ingressWildcardCertSecretName: String = "pegasus-adamaq01-fr-tls"

/// Secret the `rootDomain` wildcard Certificate (see chart.pkl) is stored in, referenced cross-app by
/// Traefik's Gateway public listener.
publicWildcardCertSecretName: String = "public-adamaq01-fr-tls"
