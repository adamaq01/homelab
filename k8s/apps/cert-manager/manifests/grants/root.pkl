/// Grants Traefik's Gateway (which lives in its own namespace) permission to
/// reference the wildcard root Certificate's Secret across namespaces.
amends "@gateway-api/ReferenceGrant.pkl"

import ".../app.pkl"
import ".../traefik/app.pkl" as traefik

metadata {
  name = "traefik-gateway-\(app.rootCertSecretName)"
  namespace = app.namespace
}

spec {
  from {
    new {
      group = "gateway.networking.k8s.io"
      kind = "Gateway"
      namespace = traefik.namespace
    }
  }
  to {
    new {
      group = ""
      kind = "Secret"
      name = app.rootCertSecretName
    }
  }
}
