/// Talos kubelets serve their metrics endpoint with a certificate metrics-server can't verify
/// (no SAN covering the address it connects on), so the API aggregation layer reports metrics-server
/// as unhealthy without `--kubelet-insecure-tls`. Also tightens the kubelet scrape settings while
/// we're touching this: a shorter resolution/timeout and an explicit request timeout.

amends "@manifest/Patch.pkl"

import "@k8s/api/apps/v1/Deployment.pkl"

patch = new Mixin<Deployment> {
  spec {
    template {
      spec {
        containers {
          [0] {
            args {
              "--kubelet-insecure-tls"
              "--kubelet-request-timeout=2s"
            }
          }
        }
      }
    }
  }
}
