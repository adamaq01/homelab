amends "@k8s/api/core/v1/ConfigMap.pkl"

import ".../app.pkl"
import ".../identity/voidauth/app.pkl" as voidauth

metadata {
  name = "headplane-config"
}

data {
  ["config.yaml"] =
    """
    server:
      cookie_secure: true
      base_url: https://\(app.hostname)
      cookie_secret_path: /etc/headplane/secrets/cookie-secret

    headscale:
      url: http://headscale.\(app.namespace).svc.cluster.local:8080
      config_path: /etc/headscale-ro/config.yaml
      api_key_path: /etc/headplane/secrets/headscale-api-key

    oidc:
      issuer: https://\(voidauth.hostname)/oidc
      client_id: headplane
      client_secret_path: /etc/headplane/secrets/headplane-client-secret

    integration:
      agent:
        enabled: true
    """
}
