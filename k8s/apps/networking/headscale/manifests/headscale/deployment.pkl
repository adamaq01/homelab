amends "@k8s/api/apps/v1/Deployment.pkl"

import ".../app.pkl"

// renovate: datasource=docker packageName=headscale/headscale
local version = "v0.29.3"

metadata {
  name = "headscale"
}

spec {
  selector {
    matchLabels {
      ["app"] = app.headscaleAppLabel
    }
  }
  strategy {
    type = "Recreate"
  }
  template {
    metadata {
      labels {
        ["app"] = app.headscaleAppLabel
      }
      annotations {
        // ConfigMap changes don't trigger a rollout on their own (kubelet just updates the
        // mounted file in place); hashing its content into a pod-template annotation forces one
        // whenever `config.yaml` actually changes.
        ["checksum/config"] = import("config-map.pkl").data["config.yaml"].md5
      }
    }
    spec {
      containers {
        new {
          name = "headscale"
          image = "headscale/headscale:\(version)"
          args { "serve" }
          ports {
            new { containerPort = 8080 }
          }
          volumeMounts {
            new { name = "config"; mountPath = "/etc/headscale" }
            new { name = "data"; mountPath = "/var/lib/headscale" }
            new { name = "secrets"; mountPath = "/etc/headscale/secrets"; readOnly = true }
          }
        }
      }
      volumes {
        new {
          name = "config"
          configMap {
            name = import("config-map.pkl").metadata.name!!
          }
        }
        new {
          name = "data"
          persistentVolumeClaim {
            claimName = import("pvc.pkl").metadata.name!!
          }
        }
        new {
          name = "secrets"
          secret {
            secretName = app.headscaleSecretName
          }
        }
      }
    }
  }
}
