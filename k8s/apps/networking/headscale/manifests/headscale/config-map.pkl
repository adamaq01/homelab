amends "@k8s/api/core/v1/ConfigMap.pkl"

import ".../app.pkl"

/// Base domain for MagicDNS node names (e.g. `mynode.\(tailnetDomain)`). Must differ from
/// [app.hostname]. Doesn't need a real DNS record: Headscale pushes it to mesh clients as an
/// overridden resolver domain, nothing external ever resolves it.
local tailnetDomain = "tailnet.\(app.rootDomain)"

metadata {
  name = "headscale-config"
}

/// `dns.nameservers.split` routes every hostname under [app.rootDomain] to the router's own DNS
/// instead of the global resolvers. That covers every private hostname (`domain`/`ingressDomain`/
/// `ingressAliasDomain` are all subdomains of it) plus every public-annotated one:
/// `external-dns-unifi` already gives those a split-horizon override on the router pointing
/// straight at `gatewayIP`, instead of the public record which resolves to the rathole VPS, so
/// routing tailnet clients' DNS here too avoids that same rathole round-trip.
data {
  ["config.yaml"] =
    """
    server_url: https://\(app.hostname)
    listen_addr: 0.0.0.0:8080
    metrics_listen_addr: 127.0.0.1:9090

    noise:
      private_key_path: /var/lib/headscale/noise_private.key

    policy:
      mode: database

    prefixes:
      v4: 100.64.0.0/10
      v6: fd7a:115c:a1e0::/48

    derp:
      urls:
        - https://controlplane.tailscale.com/derpmap/default

    database:
      type: sqlite
      sqlite:
        path: /var/lib/headscale/db.sqlite

    dns:
      magic_dns: true
      base_domain: \(tailnetDomain)
      nameservers:
        global:
          - 1.1.1.1
          - 1.0.0.1
        split:
          \(app.rootDomain):
            - \(app.routerIP)

    log:
      level: info
      format: text
    """
}
