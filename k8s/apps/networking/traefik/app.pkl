extends ".../app.pkl"

import "../cert-manager/app.pkl" as cert_manager
import "@gateway-api/HTTPRoute.pkl"
import "@traefik/Values.pkl"

// renovate: datasource=helm packageName=traefik registryUrl=https://traefik.github.io/charts
local version = "41.4.0"

// Chart default, left unset in `valuesObject` below. Referenced cross-app by HTTPRoutes'
// `parentRefs` (e.g. `dozzle/chart.pkl`).
gatewayName: String = "traefik-gateway"

local ownNamespace = namespace

/// The `parentRefs` every app's `HTTPRoute` should use, driven by the same annotations map it
/// already sets on its own `metadata` for `module.publicAnnotationKey` (see `external-dns/app.pkl`):
/// setting that one annotation is the only thing an app needs to do to also reach `websecure-public`.
/// Accepts `Dynamic` as well as `Mapping`: a Helm chart's generated `annotations` field (e.g.
/// `jellyfin/app.pkl`'s `httpRoute.annotations`) is built by `deepToTyped` without an inferred
/// element type and comes out as `Dynamic`, not `Mapping`, even though it's set the same way.
function parentRefsFor(annotations: (Dynamic|Mapping)?): Listing<HTTPRoute.ParentRef> =
  new Listing {
    new HTTPRoute.ParentRef {
      name = gatewayName
      namespace = ownNamespace
      sectionName = "websecure"
    }
    when ((annotations?.toMap() ?? Map()).containsKey(module.publicAnnotationKey)) {
      new HTTPRoute.ParentRef {
        name = gatewayName
        namespace = ownNamespace
        sectionName = "websecure-public"
      }
    }
  }

// The Gateway resource this chart creates (via `gateway.listeners`) ends up in this Application's
// own destination namespace, while cert-manager's wildcard Certificate/Secret for the domain
// lives in the `cert-manager` namespace. A ReferenceGrant there (see cert-manager's chart.pkl)
// authorizes each listener's `certificateRefs` to resolve it cross-namespace.
source {
  repoURL = "https://traefik.github.io/charts"
  chart = "traefik"
  targetRevision = version
  path = null
  helm {
    // `Values.Spec` (the vendored, generated wrapper for `service.spec`) only surfaces `type`,
    // since that's the one field the chart's own schema bothers to name explicitly even though
    // `service.spec` itself is documented as an open passthrough merged directly into the real
    // Service spec, a generated-file gap, not a real restriction, so reached via a plain Helm
    // `--set`-style parameter here instead of a `valuesObject` field.
    //
    // Needed because kube-proxy's default `externalTrafficPolicy: Cluster` SNATs every request
    // arriving via the LoadBalancer IP to a node IP before it reaches Traefik, so `IpAllowList`
    // middlewares (e.g. `headscale/chart.pkl`'s `headplaneAllowListMiddleware`) never see the real
    // client IP and reject everything regardless of its true origin. `Local` preserves it. Safe
    // with this Gateway's single replica: MetalLB (L2 mode) only announces the VIP from a node
    // with a ready local endpoint, so there's no dead-end routing risk from restricting to
    // node-local endpoints.
    parameters {
      new {
        name = "service.spec.externalTrafficPolicy"
        value = "Local"
      }
    }
    valuesObject =
      new Values {
        accessLog {
          enabled = true
        }
        // Redirects all plain HTTP traffic to HTTPS at the entrypoint level, so every app's
        // HTTPRoute only needs to target an HTTPS listener to get HTTP covered for free.
        ports {
          ["web"] {
            http {
              redirections {
                entryPoint {
                  to = "websecure"
                  scheme = "https"
                  permanent = true
                }
              }
            }
          }
          // Only `rathole`'s tunnel targets this Service port: a separate entrypoint from
          // `websecure`'s, so a request arriving via the public tunnel can only ever match an
          // HTTPRoute that explicitly attaches to `websecure-public` (see
          // `.../networking/rathole/chart.pkl`), not every HTTPRoute in the cluster by hostname
          // alone, the way it could when both LAN and tunneled traffic shared one entrypoint.
          ["websecure-public"] {
            port = 8444
            expose {
              default = true
            }
            exposedPort = 9443
          }
        }
        providers {
          kubernetesGateway {
            enabled = true
          }
        }
        gateway {
          // external-dns only honors this on the Gateway itself, never on an HTTPRoute. Safe
          // despite the single listener below carrying both private and public hostnames:
          // external-dns's `annotationFilter` (see `external-dns/app.pkl`) excludes every route
          // that isn't explicitly public.
          annotations {
            ["external-dns.alpha.kubernetes.io/target"] = module.publicGatewayHostname
          }
          listeners {
            // Namespace-restricted by default in Gateway API, but every app's HTTPRoute lives in
            // its own namespace.
            //
            // Reachable only via the LAN (MetalLB's `gatewayIP`): `rathole` never forwards to this
            // listener's port, only to `websecure-public` below. An app only needs a second
            // `parentRef` targeting `websecure-public` once it's actually meant to be public (see
            // e.g. `voidauth/manifests/http-route.pkl`); attaching only here, as most apps do, is
            // what makes an app LAN-only, not DNS non-publication.
            ["websecure"] {
              port = 8443
              protocol = "HTTPS"
              mode = "Terminate"
              namespacePolicy {
                from = "All"
              }
              certificateRefs {
                new {
                  name = cert_manager.clusterCertSecretName
                  namespace = cert_manager.namespace
                }
                new {
                  name = cert_manager.rootCertSecretName
                  namespace = cert_manager.namespace
                }
              }
            }
            // Same certs, same namespace policy: the only difference from `websecure` is which
            // Service port it's reachable on (see `ports["websecure-public"]` above).
            ["websecure-public"] {
              port = 8444
              protocol = "HTTPS"
              mode = "Terminate"
              namespacePolicy {
                from = "All"
              }
              certificateRefs {
                new {
                  name = cert_manager.clusterCertSecretName
                  namespace = cert_manager.namespace
                }
                new {
                  name = cert_manager.rootCertSecretName
                  namespace = cert_manager.namespace
                }
              }
            }
          }
        }
        service {
          annotations {
            ["metallb.io/loadBalancerIPs"] = module.gatewayIP
          }
        }
      }.toDynamic()
  }
}
