extends ".../app.pkl"

import "@argocd/Application.pkl"
import "@openbao/Values.pkl"
import ".../storage/tns-csi/app.pkl" as tns_csi

namespace = "secrets"

// renovate: datasource=helm packageName=openbao registryUrl=https://openbao.github.io/openbao-helm
local version = "0.29.4"

// Referenced cross-app by every `ExternalSecret`'s `secretStoreRef.name` (e.g.
// `.../networking/cert-manager/chart.pkl`), matching `chart.pkl`'s ClusterSecretStore.
clusterSecretStoreName = "openbao"

/// Bootstrap sequence after first deploy (OpenBao starts sealed and uninitialized; none of this can
/// be expressed as GitOps-applied manifests, since it's the very root of trust this repo's other
/// secrets ultimately chain up to):
///
/// 1. Initialize (only once, ever — re-running this against an already-initialized store wipes it):
///
///    kubectl exec -n secrets openbao-0 -- bao operator init
///
///    Save the 5 unseal key shares and the initial root token somewhere outside this cluster (a
///    password manager, printed and locked away, ...) — losing enough of them permanently locks
///    every secret this backs.
///
/// 2. Unseal (needed again after every pod restart, since the master key only ever lives in memory;
///    3 of the 5 shares from step 1 are required):
///
///    kubectl exec -n secrets openbao-0 -- bao operator unseal <key 1>
///    kubectl exec -n secrets openbao-0 -- bao operator unseal <key 2>
///    kubectl exec -n secrets openbao-0 -- bao operator unseal <key 3>
///
/// 3. Enable the KV v2 secrets engine at the path `chart.pkl`'s ClusterSecretStore expects, and
///    the Kubernetes auth method ESO authenticates through:
///
///    kubectl exec -n secrets openbao-0 -- bao login <root token>
///    kubectl exec -n secrets openbao-0 -- bao secrets enable -path=secret kv-v2
///    kubectl exec -n secrets openbao-0 -- bao auth enable kubernetes
///    kubectl exec -n secrets openbao-0 -- bao write auth/kubernetes/config \
///      kubernetes_host="https://kubernetes.default.svc.cluster.local:443"
///
/// 4. Grant ESO's own controller ServiceAccount (`external-secrets` in the `secrets`
///    namespace) read access, matching the `role = "external-secrets"` the ClusterSecretStore
///    authenticates as. `bao policy write <name> -` reads the policy body from stdin, which
///    `kubectl exec` only forwards with `-i`; without it the heredoc never reaches the container
///    and `bao` sees an empty/malformed request:
///
///    kubectl exec -i -n secrets openbao-0 -- bao policy write external-secrets - <<'EOF'
///    path "secret/data/*" {
///      capabilities = ["read"]
///    }
///    EOF
///    kubectl exec -n secrets openbao-0 -- bao write auth/kubernetes/role/external-secrets \
///      bound_service_account_names=external-secrets \
///      bound_service_account_namespaces=secrets \
///      policies=external-secrets \
///      ttl=1h
///
/// 5. Seed the actual secret values every other app's `ExternalSecret` reads (see each app's own
///    `chart.pkl`/`app.pkl` for the exact KV path/keys expected) — needed once per key, and again
///    whenever a credential is rotated:
///
///    kubectl exec -i -n secrets openbao-0 -- bao kv put secret/cloudflare api-token=<cloudflare-api-token>
///    kubectl exec -i -n secrets openbao-0 -- bao kv put secret/headplane cookie-secret="$(openssl rand -hex 16)"
///    kubectl exec -i -n secrets openbao-0 -- bao kv put secret/unifi api-key=<unifi-api-key>
///    kubectl exec -i -n secrets openbao-0 -- bao kv put secret/rathole \
///      token=<shared token, from rathole-token.txt> \
///      local-private-key=<this side's private key, from rathole-client-keys.txt> \
///      remote-public-key=<the server's public key, from rathole-server-keys.txt>
///
///    `tns-csi-credentials` (`../tns-csi/app.pkl`) is deliberately excluded from this migration
///    and stays a manually-created Secret: this Application's own PVC (`server.dataStorage`
///    above) depends on the tns-csi driver's storage class, and the driver itself depends on
///    `tns-csi-credentials` to connect to TrueNAS — sourcing that credential from here too would
///    make tns-csi (needed for this Application's own storage) depend on this Application already
///    being unsealed and serving secrets, a circular bootstrap dependency.
// This Application's manifests come from two sources at once (ArgoCD's multi-source support):
// this Helm chart, and `chart.pkl`'s hand-written HTTPRoute/ClusterSecretStore, both landing in
// the same Application rather than being split across separate ones.
sources = new Listing {
  new Application.ComparedToSource {
    repoURL = "https://openbao.github.io/openbao-helm"
    chart = "openbao"
    targetRevision = version
    helm {
      valuesObject =
        new Values {
          injector {
            enabled = false
          }
          server {
            standalone {
              enabled = true
            }
            dataStorage {
              storageClass = tns_csi.nvmeofStorageClassName
            }
          }
        }.toDynamic()
    }
  }
  module.directorySource
}
