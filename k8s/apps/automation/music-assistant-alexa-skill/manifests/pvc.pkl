amends "@k8s/api/core/v1/PersistentVolumeClaim.pkl"

import ".../storage/tns-csi/app.pkl" as tns_csi

metadata {
  name = "music-assistant-alexa-skill-ask-data"
}

spec {
  accessModes { "ReadWriteOnce" }
  storageClassName = tns_csi.nvmeofStorageClassName
  resources {
    requests {
      ["storage"] = "1Gi"
    }
  }
}
