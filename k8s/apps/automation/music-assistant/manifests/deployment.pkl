amends "@k8s/api/apps/v1/Deployment.pkl"

import "@k8s/api/core/v1/NodeSelectorTerm.pkl"

// renovate: datasource=docker packageName=ghcr.io/music-assistant/server
local version = "2.10.5"

local appLabel = "music-assistant"

metadata {
  name = "music-assistant"
}

spec {
  selector {
    matchLabels {
      ["app"] = appLabel
    }
  }
  strategy {
    // ReadWriteOnce PVC: a second pod scheduled elsewhere couldn't mount it anyway.
    type = "Recreate"
  }
  template {
    metadata {
      labels {
        ["app"] = appLabel
      }
    }
    spec {
      hostNetwork = true
      dnsPolicy = "ClusterFirstWithHostNet"
      affinity {
        nodeAffinity {
          preferredDuringSchedulingIgnoredDuringExecution {
            new {
              weight = 100
              preference {
                matchExpressions {
                  new NodeSelectorTerm.NodeSelectorRequirement {
                    key = "kubernetes.io/hostname"
                    operator = "In"
                    values { "sateda" }
                  }
                }
              }
            }
          }
        }
      }
      containers {
        new {
          name = "music-assistant"
          image = "ghcr.io/music-assistant/server:\(version)"
          ports {
            new { containerPort = 8095 }
          }
          volumeMounts {
            new { name = "data"; mountPath = "/data" }
          }
        }
      }
      volumes {
        new {
          name = "data"
          persistentVolumeClaim {
            claimName = import("pvc.pkl").metadata.name!!
          }
        }
      }
    }
  }
}
