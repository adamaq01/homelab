extends ".../app.pkl"

hostname: String = "\(module.name).\(module.ingressDomain)"
aliasHostname: String = "\(module.name).\(module.ingressAliasDomain)"

application {
  spec {
    syncPolicy {
      managedNamespaceMetadata {
        labels {
          // hostNetwork, which the default PodSecurity "baseline" level blocks.
          ["pod-security.kubernetes.io/enforce"] = "privileged"
        }
      }
    }
  }
}
