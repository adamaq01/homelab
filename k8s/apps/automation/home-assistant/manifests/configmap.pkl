amends "@k8s/api/core/v1/ConfigMap.pkl"

import ".../app.pkl"
import ".../identity/voidauth/app.pkl" as voidauth

// Pkl's `YamlRenderer` always quotes a string starting with `!`, so every one of these
// placeholders gets swapped back to a literal, unquoted tag after rendering: HA's YAML loader
// resolves `!env_var` against the process environment, and `!include` against a file path
// relative to `/config`, both at config-parse time.
local function envVarTag(name: String): String = "!env_var \(name)"

local oidcClientSecretTag = envVarTag("OIDC_CLIENT_SECRET")
local googleProjectIdTag = envVarTag("GOOGLE_PROJECT_ID")
local googleServiceAccountTag = "!include SERVICE_ACCOUNT.json"

local configuration = new {
  http {
    use_x_forwarded_for = true
    // Traefik's pod isn't hostNetwork, but this one is: cross-node traffic to a hostNetwork
    // destination gets SNAT'd to the sending node's own LAN address rather than keeping the pod
    // IP, so the node subnet needs trusting here too, not just the pod subnet.
    trusted_proxies {
      app.podSubnet
      app.nodeSubnet
    }
  }
  default_config = null
  logger {
    // `default` is a reserved property name on Dynamic
    ["default"] = "info"
  }
  auth_oidc {
    client_id = "homeassistant"
    client_secret = oidcClientSecretTag
    discovery_url = "https://\(voidauth.hostname)/oidc/.well-known/openid-configuration"
    display_name = "VoidAuth"
    features {
      default_redirect = true
    }
    roles {
      admin = "home-assistant-admins"
    }
  }
  google_assistant {
    project_id = googleProjectIdTag
    service_account = googleServiceAccountTag
  }
  alexa {
    smart_home = null
  }
}

metadata {
  name = "home-assistant-config"
}

data {
  ["configuration.yaml"] =
    List(oidcClientSecretTag, googleProjectIdTag, googleServiceAccountTag)
      .fold(
        new YamlRenderer { omitNullProperties = false }.renderDocument(configuration),
        (text, tag) -> text.replaceAll("'\(tag)'", tag),
      )
}
