/// Hand-written manifests supplementing `app.pkl`'s Helm source, folded into this same Application
/// via ArgoCD's multi-source (`sources`) support rather than a separate Application:
///
/// - The `Cluster` (CloudNativePG) backing ZITADEL's Postgres database. Owned here, in ZITADEL's
///   own app directory, rather than centralized under `.../storage/cloudnative-pg/`: each app that
///   needs its own database owns that database's lifecycle (matching `.../secrets/openbao/app.pkl`'s
///   embedded `ClusterSecretStore`).
/// - The masterkey `ExternalSecret`, sourced from OpenBao (seeded with `bao kv put secret/zitadel
///   masterkey=<32-byte-random-string>` — see `.../secrets/openbao/app.pkl`'s bootstrap step 5. Must
///   be exactly 32 bytes, printable ASCII recommended: `tr -dc A-Za-z0-9 </dev/urandom | head -c 32`).
///
/// Both get an earlier `sync-wave` (-2) than everything else in the Application: ArgoCD applies
/// every resource from every source together in ascending wave order, so this guarantees the
/// `Cluster` object (and the masterkey Secret ESO generates from the `ExternalSecret` below) land
/// before anything else. `app.pkl`'s init/setup Jobs sit in between (-1) — after these, but still
/// before the chart's main Deployment/Service (left at the chart's default, unannotated wave 0) —
/// so migrations run against a ready database without the main workload racing them and
/// crash-looping in the meantime. A `PreSync` hook was tried first instead of `sync-wave`, but
/// hooks are exempt from this Application's `ApplyOutOfSyncOnly=true` sync option (see
/// `.../app.pkl`) and so get reapplied on every single sync regardless of whether anything actually
/// changed — `sync-wave` doesn't have that downside, since it's just an ordering hint on an
/// otherwise ordinarily-diffed resource.
module chart

import ".../storage/tns-csi/app.pkl" as tns_csi
import ".../utils/ExternalSecret.pkl"
import ".../zitadel/app.pkl" as zitadel
import "@cloudnative-pg/v1/Cluster.pkl"

database: Cluster = new {
  metadata {
    name = zitadel.dbClusterName
  }
  spec {
    instances = 1
    storage {
      size = "10Gi"
      storageClass = tns_csi.postgresStorageClassName
    }
    bootstrap {
      initdb {
        database = "zitadel"
        owner = "zitadel"
      }
    }
  }
}

masterkeySecret = new ExternalSecret {
  name = zitadel.masterkeySecretName
  secrets {
    ["zitadel"] {
      "masterkey"
    }
  }
}.resource

output {
  value = new Listing {
    database
    masterkeySecret
  }
  renderer = new YamlRenderer { isStream = true }
}
