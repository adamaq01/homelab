/// Seed both once with:
///
///    kubectl exec -i -n secrets openbao-0 -- bao kv put secret/voidauth \
///      storage-key=<32+ random chars, e.g. `openssl rand -base64 32`> \
///      client-secret=<random string, e.g. `openssl rand -hex 32`>
amends "@external-secrets/v1/ExternalSecret.pkl"

import ".../app.pkl"
import ".../secrets/openbao/app.pkl" as openbao

metadata {
  name = app.secretName
}

spec {
  secretStoreRef {
    kind = "ClusterSecretStore"
    name = openbao.clusterSecretStoreName
  }
  data {
    new {
      secretKey = "storage-key"
      remoteRef {
        key = "voidauth"
        property = "storage-key"
      }
    }
    new {
      secretKey = "client-secret"
      remoteRef {
        key = "voidauth"
        property = "client-secret"
      }
    }
  }
}
