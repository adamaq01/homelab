amends "@k8s/api/core/v1/Service.pkl"

import ".../app.pkl"

metadata {
  name = "voidauth"
}

spec {
  type = "ClusterIP"
  selector {
    ["app"] = app.name
  }
  ports {
    new {
      name = "http"
      port = 3000
      targetPort = 3000
      protocol = "TCP"
    }
    new {
      name = "ldap"
      port = 3890
      targetPort = 3890
      protocol = "TCP"
    }
  }
}
