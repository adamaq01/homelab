amends "@k8s/api/apps/v1/Deployment.pkl"

import ".../app.pkl"
import ".../argocd/app.pkl" as argocd
import ".../email.pkl"
import ".../networking/headscale/app.pkl" as headscale
import "@k8s/api/core/v1/EnvVar.pkl"

// renovate: datasource=docker packageName=voidauth/voidauth
local version = "1.15.1"

metadata {
  name = "voidauth"
}

spec {
  replicas = 1
  strategy {
    // A second replica would race the first over the same Postgres-backed session/OIDC state
    // during a rollout; Recreate avoids that at the cost of a brief outage.
    type = "Recreate"
  }
  selector {
    matchLabels {
      ["app"] = app.name
    }
  }
  template {
    metadata {
      labels {
        ["app"] = app.name
      }
    }
    spec {
      containers {
        new {
          name = "voidauth"
          image = "ghcr.io/adamaq01/voidauth:latest"
          imagePullPolicy = "Always"
          // image = "voidauth/voidauth:\(version)"
          ports {
            new { containerPort = 3000 }
            new { containerPort = 3890 }
          }
          volumeMounts {
            new { name = "config"; mountPath = "/app/config" }
          }

          env =
            new Mapping {
              default = (_) -> new EnvVar.SecretKeySelector {}
              ["APP_URL"] = "https://\(app.hostname)"
              ["TRUSTED_PROXIES"] = app.podSubnet
              ["STORAGE_KEY"] {
                name = app.secretName
                key = "storage-key"
              }

              ["DB_ADAPTER"] = "postgres"
              ["DB_HOST"] = "\(app.dbClusterName)-rw.\(app.namespace).svc.cluster.local"
              ["DB_USER"] {
                name = "\(app.dbClusterName)-app"
                key = "user"
              }
              ["DB_PASSWORD"] {
                name = "\(app.dbClusterName)-app"
                key = "password"
              }
              ["DB_NAME"] {
                name = "\(app.dbClusterName)-app"
                key = "dbname"
              }

              ["SMTP_HOST"] = email.smtpHost
              ["SMTP_PORT"] = "\(email.smtpPort)"
              ["SMTP_SECURE"] = "\(email.smtpSecure)"
              ["SMTP_FROM"] {
                name = app.secretName
                key = "email-address"
              }
              ["SMTP_USER"] {
                name = app.secretName
                key = "email-address"
              }
              ["SMTP_PASS"] {
                name = app.secretName
                key = "email-password"
              }

              ["LDAP_ENABLED"] = "true"
              ["LDAP_BIND_PASSWORD"] {
                name = app.secretName
                key = "ldap-bind-password"
              }

              ["OIDC_argocd_CLIENT_DISPLAY_NAME"] = "ArgoCD"
              ["OIDC_argocd_CLIENT_HOMEPAGE_URL"] = "https://\(argocd.primaryHostname)"
              ["OIDC_argocd_CLIENT_SECRET"] {
                name = app.secretName
                key = "argocd-client-secret"
              }
              ["OIDC_argocd_CLIENT_REDIRECT_URLS"] =
                "https://\(argocd.primaryHostname)/auth/callback, https://\(argocd.aliasHostname)/auth/callback"
              ["OIDC_argocd_CLIENT_POST_LOGOUT_URLS"] = "https://\(argocd.primaryHostname)"
              ["OIDC_argocd_CLIENT_GROUPS"] = "argocd-admins"

              ["OIDC_headscale_CLIENT_DISPLAY_NAME"] = "Headscale"
              ["OIDC_headscale_CLIENT_HOMEPAGE_URL"] = "https://\(headscale.hostname)"
              ["OIDC_headscale_CLIENT_SECRET"] {
                name = app.secretName
                key = "headscale-client-secret"
              }
              ["OIDC_headscale_CLIENT_REDIRECT_URLS"] =
                "https://\(headscale.hostname)/oidc/callback"
              ["OIDC_headscale_CLIENT_POST_LOGOUT_URLS"] = "https://\(headscale.hostname)"
              ["OIDC_headscale_CLIENT_GROUPS"] = "headscale-users"

              ["OIDC_headplane_CLIENT_DISPLAY_NAME"] = "Headplane"
              ["OIDC_headplane_CLIENT_HOMEPAGE_URL"] = "https://\(headscale.hostname)/admin"
              ["OIDC_headplane_CLIENT_SECRET"] {
                name = app.secretName
                key = "headplane-client-secret"
              }
              ["OIDC_headplane_CLIENT_REDIRECT_URLS"] =
                "https://\(headscale.hostname)/admin/oidc/callback"
              ["OIDC_headplane_CLIENT_POST_LOGOUT_URLS"] = "https://\(headscale.hostname)/admin"
              ["OIDC_headplane_CLIENT_GROUPS"] = "headplane-admins"
            } |> envMapToListing
        }
      }
      volumes {
        new {
          name = "config"
          persistentVolumeClaim {
            claimName = import("pvc.pkl").metadata.name!!
          }
        }
      }
    }
  }
}

local envMapToListing = (envMap: Mapping<String, String | *EnvVar.SecretKeySelector>) -> new Listing<
  EnvVar,
> {
  for (key, val in envMap) {
    new {
      name = key
      when (val is String) {
        value = val
      }
      when (val is EnvVar.SecretKeySelector) {
        valueFrom {
          secretKeyRef = val
        }
      }
    }
  }
}
