/// Self-hosted Omnigent (<https://omnigent.ai/docs/deploy/overview>) server, using Omnigent's own
/// `agent_sandbox` provider (on-demand `Sandbox` custom resources via `.../system/agent-sandbox`'s
/// controller). Postgres-backed (CloudNativePG). Login is VoidAuth-only (OIDC) — Omnigent validates
/// the IdP's `id_token` (always JWT, confirmed in `omnigent/server/routes/auth.py`), not VoidAuth's
/// opaque access token.
///
/// Deliberately no shared/operator-managed LLM provider keys anywhere in this app: each user adds
/// their own API key or gateway through the web UI's own per-sandbox "Add a credential" dialog
/// (confirmed in `web/src/shell/HarnessCredentialForm.tsx`) the first time a harness needs one.
///
/// Seed once with:
///
///    kubectl exec -i -n secrets openbao-0 -- bao kv put secret/omnigent \
///      oidc-cookie-secret=<random string, e.g. `openssl rand -hex 32`>
///
/// Add this app's VoidAuth OIDC client secret to the existing `secret/voidauth` path (see
/// `.../identity/voidauth/manifests/secrets.pkl`'s own doc comment):
///
///    kubectl exec -i -n secrets openbao-0 -- bao kv patch secret/voidauth \
///      omnigent-client-secret=<random string, e.g. `openssl rand -hex 32`>
module chart

import ".../utils/ExternalSecret.pkl"
import "app.pkl"

// `OMNIGENT_OIDC_COOKIE_SECRET` and the VoidAuth OIDC client secret — wired individually via
// `secretKeyRef`, not a single `envFrom`.
secretsExternalSecret =
  new ExternalSecret {
    name = app.secretName
    secrets {
      ["omnigent"] {
        "oidc-cookie-secret"
      }
      ["voidauth"] {
        "omnigent-client-secret"
      }
    }
  }.resource

output {
  value = new Listing {
    secretsExternalSecret
    for (_, resource in import*("manifests/**.pkl")) {
      resource
    }
  }
  renderer = new YamlRenderer { isStream = true }
}
