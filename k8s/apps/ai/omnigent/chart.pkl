/// Self-hosted Omnigent (<https://omnigent.ai/docs/deploy/overview>) server, using
/// `.../ai/openshell` as its sandbox provider. Postgres-backed (CloudNativePG). Login is
/// VoidAuth-only (OIDC) — Omnigent validates the IdP's `id_token` (always JWT, confirmed in
/// `omnigent/server/routes/auth.py`), not VoidAuth's opaque access token, so this doesn't hit the
/// JWT-access-token requirement that blocks OpenShell gateway login itself (see
/// `.../ai/openshell/app.pkl`'s doc comment).
///
/// Seed once with:
///
///    kubectl exec -i -n secrets openbao-0 -- bao kv put secret/omnigent \
///      oidc-cookie-secret=<random string, e.g. `openssl rand -hex 32`> \
///      openai-api-key=<optional, only if sandboxes should get OPENAI_API_KEY>
///
/// Add this app's VoidAuth OIDC client secret to the existing `secret/voidauth` path (see
/// `.../identity/voidauth/manifests/secrets.pkl`'s own doc comment):
///
///    kubectl exec -i -n secrets openbao-0 -- bao kv patch secret/voidauth \
///      omnigent-client-secret=<random string, e.g. `openssl rand -hex 32`>
///
/// Kubernetes has no cross-namespace Secret reference, so the OpenShell gateway's client mTLS
/// bundle (`.../ai/openshell`'s own `openshell-client-tls` Secret) has to be re-synced into
/// OpenBao once, so this app's own `ExternalSecret` can pull it into its own namespace:
///
///    kubectl get secret -n openshell openshell-client-tls -o json | \
///      kubectl exec -i -n secrets openbao-0 -- bao kv put secret/openshell-client \
///        ca.crt=- tls.crt=- tls.key=- \
///      2>/dev/null || \
///    bash -c '
///      ca="$(kubectl get secret -n openshell openshell-client-tls -o jsonpath="{.data.ca\.crt}" | base64 -d)"
///      crt="$(kubectl get secret -n openshell openshell-client-tls -o jsonpath="{.data.tls\.crt}" | base64 -d)"
///      key="$(kubectl get secret -n openshell openshell-client-tls -o jsonpath="{.data.tls\.key}" | base64 -d)"
///      kubectl exec -i -n secrets openbao-0 -- bao kv put secret/openshell-client \
///        "ca.crt=${ca}" "tls.crt=${crt}" "tls.key=${key}"
///    '
///
/// Only the raw cert bytes are copied this way — the actual `~/.config/openshell/` directory
/// layout (`metadata.json`, `active_gateway`, the `mtls/` subdirectory) is generated by the real
/// `openshell` CLI at pod startup, not hand-built here: see `manifests/deployment.pkl`'s init
/// container.
module chart

import ".../utils/ExternalSecret.pkl"
import "app.pkl"

// `OMNIGENT_OIDC_COOKIE_SECRET`, the VoidAuth OIDC client secret, and the LLM provider key
// sandboxes get injected with (see `../config.pkl`'s `sandbox.openshell.env` list) — these land as
// individual env vars on the server container via `secretKeyRef`, not a single `envFrom`.
secretsExternalSecret =
  new ExternalSecret {
    name = app.secretName
    secrets {
      ["omnigent"] {
        "oidc-cookie-secret"
        "openai-api-key"
      }
      ["voidauth"] {
        "omnigent-client-secret"
      }
    }
  }.resource

// The OpenShell client mTLS bundle, mounted as a file volume (not `envFrom`) for the init
// container to copy into the CLI's expected gateway-config path.
openshellClientExternalSecret =
  new ExternalSecret {
    name = app.openshellClientSecretName
    secrets {
      ["openshell-client"] {
        "ca.crt"
        "tls.crt"
        "tls.key"
      }
    }
  }.resource

output {
  value = new Listing {
    secretsExternalSecret
    openshellClientExternalSecret
    for (_, resource in import*("manifests/**.pkl")) {
      resource
    }
  }
  renderer = new YamlRenderer { isStream = true }
}
