/// `OMNIGENT_CONFIG` contents: only the sandbox section is needed here — secrets (`DATABASE_URL`,
/// the cookie secret) stay in the environment, per the upstream
/// `deploy/kubernetes/overlays/sandbox-runners/sandbox-config.yaml` convention (tag v0.23.0).
module config

import "app.pkl"

value = new Dynamic {
  sandbox {
    provider = "agent_sandbox"
    // In-cluster service DNS, not the external hostname: this is what the runner Pod's host
    // dials back to, and it never leaves the cluster network.
    server_url = "http://omnigent.\(app.namespace).svc.cluster.local"
    // `agent_sandbox` reads this same `kubernetes:` block (confirmed in the upstream overlay's own
    // docs: "switching sandbox.provider between the two needs no other config change"). No
    // `secret_name` and no shared LLM credentials/gateway here on purpose: each user brings their
    // own via the web UI's own per-host "Add a credential" dialog (adopt / API key / gateway) —
    // confirmed in `web/src/shell/HarnessCredentialForm.tsx` — instead of one shared key for
    // everyone. `secret_name` is optional (defaults to unset) and only adds an `envFrom` to the
    // runner Pod when set, so omitting it entirely means no forced Secret dependency either.
    kubernetes {
      namespace = app.sandboxNamespace
      service_account = app.runnerServiceAccountName
    }
  }
}
