/// `OMNIGENT_CONFIG` contents: only the sandbox section is needed here — secrets (`DATABASE_URL`,
/// the cookie secret, LLM keys) stay in the environment, per the upstream openshell overlay's own
/// convention (confirmed at `deploy/kubernetes/overlays/openshell/server-config.yaml`, tag
/// v0.23.0).
module config

import "app.pkl"

value = new Dynamic {
  sandbox {
    provider = "openshell"
    server_url = "https://\(app.hostname)"
    openshell {
      // Server env var NAMES forwarded into every sandbox at provision time. *_BASE_URL points
      // every sandbox's OpenAI- and Anthropic-compatible clients (including Claude Code, the
      // built-in harness) at LiteLLM instead of api.openai.com/api.anthropic.com — both API keys
      // (seeded in secret/omnigent) must be LiteLLM virtual keys, not raw provider keys.
      env {
        "OPENAI_API_KEY"
        "OPENAI_BASE_URL"
        "ANTHROPIC_API_KEY"
        "ANTHROPIC_BASE_URL"
        // Makes Claude Code query LiteLLM for the actual available models instead of assuming
        // Anthropic's own model lineup, which LiteLLM doesn't necessarily mirror 1:1.
        "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY"
      }
    }
  }
}
