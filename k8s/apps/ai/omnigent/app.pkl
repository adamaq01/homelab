extends ".../app.pkl"

hostname: String = "omnigent.\(module.rootDomain)"

dbClusterName: String = "omnigent-db"

/// Holds the OIDC client secret + cookie secret, and (via the CNPG app secret, referenced
/// directly) `DATABASE_URL`'s components. The LLM provider keys sandboxes get injected with live
/// in [sandboxCredsSecretName] instead.
secretName: String = "omnigent-secrets"

/// Dedicated namespace for on-demand `agent_sandbox`-provisioned runner Pods, kept separate from
/// [namespace] so the server's RBAC grant there (`manifests/sandboxes-role.pkl`) can never reach
/// the server/DB Pods or this app's own Secrets.
sandboxNamespace: String = "omnigent-sandboxes"

/// The runner Pods' own (deliberately powerless) ServiceAccount, in [sandboxNamespace].
runnerServiceAccountName: String = "omnigent-runner"

/// The server's own ServiceAccount, bound to the RBAC grant in [sandboxNamespace] that lets it
/// manage runner `Sandbox` resources there.
serverServiceAccountName: String = "omnigent-server"

/// Harness LLM credentials, projected into every runner Pod via `envFrom` — see
/// `manifests/sandboxes-creds-secret.pkl`.
sandboxCredsSecretName: String = "omnigent-creds"
