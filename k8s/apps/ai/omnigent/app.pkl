extends ".../app.pkl"

hostname: String = "omnigent.\(module.rootDomain)"

dbClusterName: String = "omnigent-db"

/// Holds the OIDC client secret + cookie secret, the OpenAI key OpenShell sandboxes get injected
/// with, and (via the CNPG app secret, referenced directly) `DATABASE_URL`'s components.
secretName: String = "omnigent-secrets"

/// The raw OpenShell client mTLS bundle (`ca.crt`/`tls.crt`/`tls.key`), copied once from
/// `.../ai/openshell`'s own `openshell-client-tls` Secret into OpenBao — see `chart.pkl`'s doc
/// comment for the seed command. Kubernetes has no cross-namespace Secret reference, so this is
/// the one piece of raw cert material that has to be re-synced into this namespace at all; the
/// gateway-config directory layout built from it is generated by the real `openshell` CLI (see
/// `manifests/deployment.pkl`'s init container), not hand-constructed here.
openshellClientSecretName: String = "openshell-client-cert"
