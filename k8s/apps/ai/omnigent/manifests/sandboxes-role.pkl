amends "@k8s/api/rbac/v1/Role.pkl"

import ".../app.pkl"

/// Namespaced (not cluster-scoped), so this can only ever touch objects in [app.sandboxNamespace]
/// — never the server/DB Pod or this app's own Secrets in [app.namespace]. Mirrors upstream's own
/// `deploy/kubernetes/overlays/sandbox-runners/role.yaml` exactly (tag v0.23.0).
metadata {
  name = "omnigent-sandbox-manager"
  namespace = app.sandboxNamespace
}

rules {
  new {
    // `provider: agent_sandbox` Sandbox custom resources (kubernetes-sigs/agent-sandbox): create
    // one, read it back, patch spec.shutdownTime to keep a busy sandbox alive, delete at
    // terminate. `watch` is withheld — the launcher polls the backing Pod; the controller reaps.
    apiGroups { "agents.x-k8s.io" }
    resources { "sandboxes" }
    verbs { "create"; "get"; "patch"; "delete" }
  }
  new {
    // Lists Pods by job-name label to find a Job's child Pod (the `kubernetes` provider's bare-Job
    // path); `delete` is also needed by `agent_sandbox` to clear a finished Pod when waking a
    // suspended sandbox, since the controller won't replace a Pod in a terminal phase.
    apiGroups { "" }
    resources { "pods" }
    verbs { "create"; "list"; "get"; "delete" }
  }
  new {
    // Start-failure diagnostics only: tails the failed container's log.
    apiGroups { "" }
    resources { "pods/log" }
    verbs { "get" }
  }
  new {
    // The per-launch token rides a per-sandbox Secret referenced by the Pod's `secretKeyRef`.
    apiGroups { "" }
    resources { "secrets" }
    verbs { "create"; "delete" }
  }
  new {
    // Surfaces scheduler/kubelet events in the provider's error messages.
    apiGroups { "" }
    resources { "events" }
    verbs { "list" }
  }
}
