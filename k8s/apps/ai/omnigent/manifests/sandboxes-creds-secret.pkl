amends "@external-secrets/v1/ExternalSecret.pkl"

import ".../app.pkl"
import ".../secrets/openbao/app.pkl" as openbao

/// Harness LLM credentials, projected into every runner Pod via `envFrom` — the keys here ARE the
/// env var names a harness reads directly (`ANTHROPIC_API_KEY`, `OPENAI_API_KEY`), unlike
/// `../chart.pkl`'s `secretsExternalSecret`, whose keys are wired individually via `secretKeyRef`
/// and so can stay kebab-cased to match the OpenBao property names below.
metadata {
  name = app.sandboxCredsSecretName
  namespace = app.sandboxNamespace
}

spec {
  secretStoreRef {
    kind = "ClusterSecretStore"
    name = openbao.clusterSecretStoreName
  }
  data {
    new {
      secretKey = "ANTHROPIC_API_KEY"
      remoteRef {
        key = "omnigent"
        property = "anthropic-api-key"
      }
    }
    new {
      secretKey = "OPENAI_API_KEY"
      remoteRef {
        key = "omnigent"
        property = "openai-api-key"
      }
    }
  }
}
