amends "@k8s/api/core/v1/Namespace.pkl"

import ".../app.pkl"

metadata {
  name = app.sandboxNamespace
  labels {
    // Defense-in-depth: the server's RBAC grant here includes `pods:create`, so this keeps a
    // compromised server from creating a privileged / hostPath / host-namespace Pod even so.
    ["pod-security.kubernetes.io/enforce"] = "restricted"
    ["pod-security.kubernetes.io/enforce-version"] = "latest"
    ["pod-security.kubernetes.io/warn"] = "restricted"
    ["pod-security.kubernetes.io/audit"] = "restricted"
  }
}
