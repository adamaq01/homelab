amends "@k8s/api/apps/v1/Deployment.pkl"

import ".../app.pkl"
import ".../identity/voidauth/app.pkl" as voidauth
import ".../storage/tns-csi/app.pkl" as tns_csi

// renovate: datasource=docker packageName=ghcr.io/omnigent-ai/omnigent-server-kubernetes
local version = "v0.23.0"

local appLabel = "omnigent"

metadata {
  name = "omnigent"
}

spec {
  selector {
    matchLabels {
      ["app"] = appLabel
    }
  }
  template {
    metadata {
      labels {
        ["app"] = appLabel
      }
    }
    spec {
      serviceAccountName = app.serverServiceAccountName
      containers {
        new {
          name = "omnigent"
          image = "ghcr.io/omnigent-ai/omnigent-server-kubernetes:\(version)"
          ports {
            new { containerPort = 8000; name = "http" }
          }
          envFrom {
            new { configMapRef { name = "omnigent-config" } }
          }
          env {
            new { name = "OMNIGENT_AUTH_PROVIDER"; value = "oidc" }
            new { name = "OMNIGENT_OIDC_ISSUER"; value = "https://\(voidauth.hostname)/oidc" }
            new { name = "OMNIGENT_OIDC_CLIENT_ID"; value = "omnigent" }
            new {
              name = "OMNIGENT_OIDC_CLIENT_SECRET"
              valueFrom {
                secretKeyRef { name = app.secretName; key = "omnigent-client-secret" }
              }
            }
            new {
              name = "OMNIGENT_OIDC_REDIRECT_URI"
              value = "https://\(app.hostname)/auth/callback"
            }
            new {
              name = "OMNIGENT_OIDC_COOKIE_SECRET"
              valueFrom {
                secretKeyRef { name = app.secretName; key = "oidc-cookie-secret" }
              }
            }
            // Moves each runner Pod's $HOME onto a per-sandbox PVC instead of an emptyDir, so the
            // workspace, ~/.omnigent and harness caches all survive an agent_sandbox suspend/resume.
            new { name = "OMNIGENT_AGENT_SANDBOX_WORKSPACE_SIZE"; value = "20Gi" }
            new {
              name = "OMNIGENT_AGENT_SANDBOX_STORAGE_CLASS"
              value = tns_csi.nvmeofStorageClassName
            }
            new {
              name = "DB_USER"
              valueFrom {
                secretKeyRef { name = "\(app.dbClusterName)-app"; key = "user" }
              }
            }
            new {
              name = "DB_PASSWORD"
              valueFrom {
                secretKeyRef { name = "\(app.dbClusterName)-app"; key = "password" }
              }
            }
            new {
              name = "DB_HOST"
              valueFrom {
                secretKeyRef { name = "\(app.dbClusterName)-app"; key = "host" }
              }
            }
            new {
              name = "DB_PORT"
              valueFrom {
                secretKeyRef { name = "\(app.dbClusterName)-app"; key = "port" }
              }
            }
            new {
              name = "DB_NAME"
              valueFrom {
                secretKeyRef { name = "\(app.dbClusterName)-app"; key = "dbname" }
              }
            }
            new {
              name = "DATABASE_URL"
              value = "postgresql+psycopg://$(DB_USER):$(DB_PASSWORD)@$(DB_HOST):$(DB_PORT)/$(DB_NAME)"
            }
          }
          volumeMounts {
            new { name = "artifacts"; mountPath = "/data/artifacts" }
            new {
              name = "server-config"
              mountPath = "/data/server-config.yaml"
              subPath = "config.yaml"
              readOnly = true
            }
          }
          resources {
            requests {
              ["memory"] = "512Mi"
              ["cpu"] = "250m"
            }
            limits {
              ["memory"] = "1Gi"
              ["cpu"] = "1000m"
            }
          }
          livenessProbe {
            httpGet {
              path = "/health"
              port = 8000
            }
            initialDelaySeconds = 20
            periodSeconds = 30
            timeoutSeconds = 5
          }
          readinessProbe {
            httpGet {
              path = "/health"
              port = 8000
            }
            initialDelaySeconds = 10
            periodSeconds = 10
            timeoutSeconds = 5
          }
        }
      }
      volumes {
        new {
          name = "artifacts"
          persistentVolumeClaim {
            claimName = import("pvc.pkl").metadata.name!!
          }
        }
        new {
          name = "server-config"
          configMap {
            name = import("server-config-configmap.pkl").metadata.name!!
          }
        }
      }
    }
  }
}
