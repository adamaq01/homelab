amends "@k8s/api/core/v1/ServiceAccount.pkl"

import ".../app.pkl"

metadata {
  name = app.runnerServiceAccountName
  namespace = app.sandboxNamespace
}

// Runner Pods set `automountServiceAccountToken: false` regardless; this SA is a policy handle
// (NetworkPolicy, PodSecurity, quotas can target runner Pods distinctly), not an access grant.
automountServiceAccountToken = false
