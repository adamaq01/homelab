extends ".../app.pkl"

import "@argocd/Application.pkl"
import ".../storage/tns-csi/app.pkl" as tns_csi

namespace: String = "openshell"

secretName: String = "openshell-secrets"

// renovate: datasource=github-releases packageName=NVIDIA/OpenShell
local version = "0.1.9"

/// `kubernetes-sigs/agent-sandbox` (`.../system/agent-sandbox`) must already be installed; this
/// chart deliberately doesn't manage that CRD/controller itself.
///
/// OIDC login (VoidAuth) is deliberately not wired up yet: the gateway requires JWT-format access
/// tokens with no introspection fallback, and VoidAuth issues opaque ones — every login would fail
/// regardless of Helm config, since that's a VoidAuth server-side fix (`node-oidc-provider`'s
/// `features.resourceIndicators.getResourceServerInfo` returning `accessTokenFormat: "jwt"`), not
/// something expressible here. Until that's done, auth falls back to the chart's own default: TLS
/// and mTLS stay enabled (no `server.disableTls`/`tls.enableMtls` override), so a client needs the
/// gateway's client certificate bundle, and the gateway isn't exposed via Traefik's HTTPRoute/
/// GRPCRoute (which terminates TLS and would strip the client cert before it reaches the pod) —
/// reach it with `kubectl port-forward`, or a ClusterIP-only internal client, for now.
///
/// OpenBao: seed the gateway's credential-encryption key once, so it survives every Helm render
/// (the chart would otherwise mint a new one — and therefore lose every stored credential — on
/// every ArgoCD sync, since `lookup()` isn't available to the Helm renderer here):
///
///    kubectl exec -i -n secrets openbao-0 -- bao kv put secret/openshell \
///      key-encryption-key="$(openssl rand -base64 32)"
///
/// See `sandbox-policy.pkl` for the gateway-wide sandbox policy (filesystem + network access for
/// sandboxed workloads) and its own one-time apply command — there's no CRD for it, so it's
/// tracked here but applied out-of-band, same as this comment's OpenBao seed step.
sources = new Listing {
  new Application.ComparedToSource {
    repoURL = "oci://ghcr.io/nvidia/openshell/helm-chart"
    targetRevision = version
    path = "."
    helm {
      valuesObject = new {
        certManager {
          enabled = true
        }
        server {
          dataStorageClass = tns_csi.nvmeofStorageClassName
          // No default StorageClass in this cluster — without this, every sandbox's workspace PVC
          // stays Pending forever and the sandbox never starts.
          workspaceStorageClass = tns_csi.nvmeofStorageClassName
          // `ghcr.io/omnigent-ai/omnigent-host` bakes in a `sandbox` user at this (OpenShift-SCC
          // style) UID/GID and owns `/sandbox` 0700 to it. With no SCC present, the driver's own
          // default (10001) can't read that directory at all — seed-workspace fails with EPERM
          // before the sandbox container ever starts.
          sandboxUid = 1000660000
          sandboxGid = 1000660000
          credentialStorage {
            existingSecret = secretName
          }
          telemetryEnabled = false
        }
      }
    }
  }
  module.directorySource
}
