/// The gateway-wide sandbox policy, applied with `openshell policy set --global --policy ...`.
/// There's no Kubernetes resource or CRD for this — it's a CLI-only gateway concept — so this file
/// is the tracked source of truth and applying it is a one-time, non-GitOps operator action,
/// re-run whenever this file changes:
///
///    pkl eval k8s/apps/ai/openshell/sandbox-policy.pkl -o /tmp/sandbox-policy.yaml
///    openshell gateway add https://openshell.openshell.svc.cluster.local:8080 --name openshell --local
///    openshell policy set --global --policy /tmp/sandbox-policy.yaml --yes
///
/// (the `gateway add` step needs the mTLS client bundle from `openshell-client-tls` in this
/// namespace — see `.../ai/omnigent/chart.pkl`'s doc comment for how that bundle gets generated
/// and synced elsewhere.)
///
/// This is deliberately permissive — single homelab, single operator, not a shared/public
/// gateway — rather than enumerating every path and host a given harness (Claude Code, Codex,
/// etc.) happens to need. OpenShell's own default filesystem policy denies `/opt`, `/home`,
/// `/var`, `/root`, `/srv`, `/mnt` outright regardless of actual Unix permission bits (Landlock
/// enforces a fixed allowlist), which broke `ghcr.io/omnigent-ai/omnigent-host` (its Python venv
/// lives at `/opt/venv`) and would keep breaking on whatever the next harness needs. The default
/// also denies all outbound network access.
module sandboxPolicy

policy = new Dynamic {
  version = 1
  filesystem_policy {
    include_workdir = true
    read_only {
      "/"
    }
    read_write {
      "/tmp"
      "/root"
      "/home"
      "/opt"
      "/var"
      "/srv"
      "/mnt"
    }
  }
  // Hostless + allowed_ips 0.0.0.0/0 (rather than a wildcard host, which OpenShell requires to
  // have at least 3 DNS labels and so can't express "any host") grants outbound access to any
  // destination — OpenShell still always blocks loopback/link-local/unspecified addresses and the
  // Kubernetes/etcd control-plane ports regardless of this policy. `/**` matches any binary.
  network_policies {
    ["allow-all"] {
      endpoints {
        new {
          allowed_ips {
            "0.0.0.0/0"
            "::/0"
          }
          ports {
            80
            443
          }
        }
      }
      binaries {
        new { path = "/**" }
      }
    }
  }
}

output {
  value = policy
  renderer = new YamlRenderer {}
}
