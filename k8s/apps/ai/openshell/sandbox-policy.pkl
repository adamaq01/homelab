/// The gateway-wide sandbox policy, applied with `openshell policy set --global --policy ...`.
/// There's no Kubernetes resource or CRD for this — it's a CLI-only gateway concept — so this file
/// is the tracked source of truth and applying it is a one-time, non-GitOps operator action,
/// re-run whenever this file changes:
///
///    pkl eval k8s/apps/ai/openshell/sandbox-policy.pkl -o /tmp/sandbox-policy.yaml
///    openshell gateway add https://openshell.openshell.svc.cluster.local:8080 --name openshell --local
///    openshell policy set --global --policy /tmp/sandbox-policy.yaml --yes
///
/// (the `gateway add` step needs the mTLS client bundle from `openshell-client-tls` in this
/// namespace — see `.../ai/omnigent/chart.pkl`'s doc comment for how that bundle gets generated
/// and synced elsewhere.)
///
/// This is deliberately permissive — single homelab, single operator, not a shared/public
/// gateway — rather than enumerating every path and host a given harness (Claude Code, Codex,
/// etc.) happens to need. OpenShell's own default filesystem policy denies `/opt`, `/home`,
/// `/var`, `/root`, `/srv`, `/mnt` outright regardless of actual Unix permission bits (Landlock
/// enforces a fixed allowlist), which broke `ghcr.io/omnigent-ai/omnigent-host` (its Python venv
/// lives at `/opt/venv`) and would keep breaking on whatever the next harness needs. The default
/// also denies all outbound network access.
module sandboxPolicy

policy = new Dynamic {
  version = 1
  filesystem_policy {
    include_workdir = true
    read_only {
      "/"
    }
    read_write {
      "/tmp"
      "/root"
      "/home"
      "/opt"
      "/var"
      "/srv"
      "/mnt"
    }
  }
  // OpenShell has no "disable network policy" switch at all (confirmed against its own docs and
  // schema) — it's always default-deny with an explicit allowlist, by design. A hostless
  // allowed_ips rule (what this used to be) goes through "transparent TCP" handling, which
  // OpenShell's own examples confirm the Kubernetes compute driver doesn't support at all — it
  // "fails closed" there (Docker/Podman only). The closest thing to "no policy" the Kubernetes
  // driver actually supports is: every host we might plausibly need, matched explicitly or via a
  // same-domain wildcard (OpenShell requires wildcards to have >= 3 DNS labels and only one `**`
  // as the whole first label — there's no syntax for "any domain" at all), in `audit` mode (logs
  // rule violations but still allows the request, rather than `enforce` blocking them) and `/**`
  // for "any binary". Add more hosts here as needed; there's no way to make this unbounded.
  local function host(h: String) = new {
    host = h
    ports {
      80
      443
    }
    access = "full"
    enforcement = "audit"
  }
  network_policies {
    ["allow-known-hosts"] {
      endpoints {
        // Wildcard/hostless endpoints can only reach private addresses via allowed_ips (per
        // OpenShell's docs) — our own domain resolves to an internal LB IP (192.168.2.0/24, the
        // homelab's node subnet), so the wildcard needs this explicitly or every internal hostname
        // fails DNS resolution from inside the sandbox (confirmed empirically).
        (host("**.adamaq01.fr")) {
          allowed_ips {
            "192.168.2.0/24"
          }
        }
        host("github.com")
        host("**.github.com")
        host("**.githubusercontent.com")
        host("pypi.org")
        host("**.pythonhosted.org")
        host("**.npmjs.org")
        host("**.python.org")
        host("**.readthedocs.io")
        host("**.huggingface.co")
        host("**.anthropic.com")
        host("**.openai.com")
        host("**.google.com")
        host("duckduckgo.com")
        host("stackoverflow.com")
        host("arxiv.org")
        host("crates.io")
        host("**.crates.io")
        host("**.debian.org")
        host("**.ubuntu.com")
        host("**.docker.io")
        host("**.docker.com")
      }
      binaries {
        new { path = "/**" }
      }
    }
  }
}

output {
  value = policy
  renderer = new YamlRenderer {}
}
