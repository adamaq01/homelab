// Top-level module for defining an ArgoCD Application resource.
// The actual root App for the App-of-Apps pattern is directly defined in `k8s/chart.pkl`.
open module app

extends "common.pkl"

import "pkl:reflect"
import "@argocd/Application.pkl"

local function findRoot(mod: reflect.Module): Module =
  if (mod.supermodule == null)
    mod.reflectee
  else
    findRoot(mod.supermodule!!)

local relativePath = findRoot(reflect.Module(module)).relativePathTo(module)

name: String = relativePath.last
namespace: String = name
autoSync: Boolean = true
project: String = "default"
source: Application.SpecSource = new {
  repoURL = module.repoURL
  targetRevision = module.targetRevision
  path = relativePath.join("/")
}

/// This directory's own path as an `ComparedToSource`, for an app that needs to combine
/// hand-written manifests (via the CMP `Directory`-type source every other multi-source entry
/// below it is) alongside `source` above. Left out of `sources` by default: set `sources` (which
/// takes priority over `source` once non-null) to a `Listing` including this when needed.
directorySource: Application.ComparedToSource = new {
  repoURL = module.repoURL
  targetRevision = module.targetRevision
  path = relativePath.join("/")
}

/// When set, used instead of `source` (ArgoCD's multi-source Application feature): lets one
/// Application combine, e.g., a Helm-chart source with this directory's own hand-written
/// manifests (`directorySource`) rather than needing a separate Application per source.
sources: Listing<Application.ComparedToSource>? = null

local app = this

application: Application = new {
  metadata {
    name = app.name
    namespace = module.argoCDNamespace
    annotations {
      // Reduces diff noise from server-defaulted fields.
      ["argocd.argoproj.io/compare-options"] = "ServerSideDiff=true"
    }
  }
  spec {
    project = app.project
    when (app.sources != null) {
      sources = app.sources
    } else {
      source = app.source
    }
    destination {
      name = "in-cluster"
      namespace = app.namespace
    }
    syncPolicy {
      when (app.autoSync) {
        automated {
          prune = true
          selfHeal = true
        }
      }
      syncOptions {
        "ApplyOutOfSyncOnly=true"
        "CreateNamespace=true"
        "ServerSideApply=true"
      }
    }
  }
}
