import "../apps/openbao/app.pkl" as openbao
import "@external-secrets/v1/ExternalSecret.pkl"

name: String
namespace: String?
secrets: Mapping<String, Listing<String>>

fixed resource = new ExternalSecret {
  metadata {
    name = module.name
    when (module.namespace != null) {
      namespace = module.namespace
    }
  }
  spec {
    secretStoreRef {
      kind = "ClusterSecretStore"
      name = openbao.clusterSecretStoreName
    }
    data {
      for (refKey, secrets in module.secrets) {
        for (secret in secrets) {
          new {
            secretKey = secret
            remoteRef {
              key = refKey
              property = secret
            }
          }
        }
      }
    }
  }
}

output {
  value = resource
  renderer = new YamlRenderer {}
}
