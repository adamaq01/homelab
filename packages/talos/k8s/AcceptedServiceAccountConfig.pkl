module k8s.AcceptedServiceAccountConfig

extends ".../TalosObject.pkl"

/// publicKeys
///
/// The list of public keys which are used to verify the service account tokens.
///
/// These keys are used by the Kubernetes API server to verify the service account tokens. The keys must
