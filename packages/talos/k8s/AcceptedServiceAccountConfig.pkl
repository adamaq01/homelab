publicKeys: Listing<String>?

/// issuers
///
/// The additional service account issuers which are accepted by the Kubernetes API server.
///
/// This might be used for service account rotation, or for accepting service accounts from other
/// clusters, or for accepting service accounts from other issuers.
issuers: Listing<String(contains(Regex("^(http|https)://")))>?

/// audiences
///
/// The list of API audiences for which the service account tokens are accepted by the Kubernetes API
/// server.
///
/// If this field is not set, the default is to set to the issuer URL of the service account issuer.
audiences: Listing<String>?
