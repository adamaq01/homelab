/// KubeNetworkConfig configures Kubernetes base network settings.
///
/// This module was generated from JSON Schema from
/// <https://raw.githubusercontent.com/siderolabs/talos/v1.14.0/pkg/machinery/config/schemas/config.schema.json>.
module k8s.KubeNetworkConfigV1Alpha1

extends ".../TalosDocument.pkl"

apiVersion = "v1alpha1"

kind = "KubeNetworkConfig"

/// dnsDomain
///
/// The domain used by Kubernetes DNS. The default is cluster.local
dnsDomain: String?

/// podSubnets
///
/// The pod subnet (CIDR), this can be a single value or two values for dual-stack clusters.
podSubnets: Listing<String(matches(Regex(#"^[0-9a-f.:]+/\d{1,3}$"#)))>

/// serviceSubnets
///
/// The service subnet (CIDR), this can be a single value or two values for dual-stack clusters.
serviceSubnets: Listing<String(matches(Regex(#"^[0-9a-f.:]+/\d{1,3}$"#)))>

/// nodeCIDRMaskSizeIPv4
///
/// The IPv4 per-node pod CIDR mask size, i.e. the size of the pod CIDR allocated to each node, from the
/// IPv4 pod subnet. The default is 24. Must be between 1 and 32.
nodeCIDRMaskSizeIPv4: Int(isBetween(1, 32))?

/// nodeCIDRMaskSizeIPv6
///
/// The IPv6 per-node pod CIDR mask size, i.e. the size of the pod CIDR allocated to each node, from the
/// IPv6 pod subnet. The default is 64. Must be between 1 and 128.
nodeCIDRMaskSizeIPv6: Int(isBetween(1, 128))?
