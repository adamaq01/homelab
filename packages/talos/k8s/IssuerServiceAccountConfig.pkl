/// IssuerServiceAccountConfig configures the service account issuer.
///
/// This module was generated from JSON Schema from
/// <https://raw.githubusercontent.com/siderolabs/talos/v1.14.0/pkg/machinery/config/schemas/config.schema.json>.
module k8s.IssuerServiceAccountConfig

extends ".../TalosObject.pkl"

/// privateKey
///
/// The key which is used to sign the service account tokens.
///
/// This key is used to sign the service account tokens, and it is used by the Kubernetes API server to
/// verify the service account tokens. The key must be a valid PEM encoded RSA or ECDSA private key.
privateKey: String

/// issuerURL
///
/// The issuer URL which is used to sign the service account tokens.
///
/// This URL is used to sign the service account tokens, and it is used by the Kubernetes API server to
/// verify the service account tokens.
issuerURL: String(contains(Regex("^(http|https)://")))
