/// KubeAPIServerConfig configures kube-apiserver controlplane static pod.
///
/// This module was generated from JSON Schema from
/// <https://raw.githubusercontent.com/siderolabs/talos/v1.14.0/pkg/machinery/config/schemas/config.schema.json>.
module k8s.KubeAPIServerConfigV1Alpha1

extends ".../TalosDocument.pkl"

apiVersion = "v1alpha1"

kind = "KubeAPIServerConfig"

/// image
///
/// The container image used to run the kube-apiserver component.
///
/// The image reference should contain the tag, even if it is pinned by digest.
image: String

/// extraArgs
///
/// Extra command line arguments to supply to the kube-apiserver.
extraArgs: Mapping<String, String|Listing<String>>?

/// env
///
/// The env field allows for the addition of environment variables for the kube-apiserver.
env: Mapping<String(contains(Regex(".*"))), String>?

/// resources
///
/// Configure the kube-apiserver resources.
resources: Dynamic?

/// apiPort
///
/// The port on which the kube-apiserver will listen for requests.
///
/// Default is 6443.
apiPort: Int?

/// certExtraSANs
///
/// Provide extra certificate SANs (hostnames, IPs) to add to the kube-apiserver serving certificate.
///
/// Talos automatically adds machine’s addresses and hostnames, Kubernetes names, and control plane
/// endpoint derived SANs to the kube-apiserver serving certificate. This field allows for adding
/// additional SANs to the serving certificate.
