/// KubeFlannelCNIConfig deploys Flannel CNI to the cluster.
///
/// This module was generated from JSON Schema from
/// <https://raw.githubusercontent.com/siderolabs/talos/v1.14.0/pkg/machinery/config/schemas/config.schema.json>.
module k8s.KubeFlannelCNIConfigV1Alpha1

extends ".../TalosDocument.pkl"

apiVersion = "v1alpha1"

kind = "KubeFlannelCNIConfig"

/// backendType
///
/// Type of the Flannel backend to use.
///
/// See Flannel documentation for supported backend types. The default value in generated machine
/// configuration is “vxlan”.
backendType: String?

/// backendPort
///
/// UDP port used by Flannel for encapsulating traffic (if the backend type requires encapsulation).
///
/// The default value in generated machine configuration is 4789.
backendPort: Int?

/// backendMTU
///
/// Transport MTU to be used for the pod network.
///
/// Flannel will subtract encapsulation overhead from this MTU to calculate the MTU of the pod interface.
/// If not set, the default is auto-detection of MTU by Flannel. If KubeSpan is enabled, and the value is
/// not set, defaults to KubeSpan MTU.
backendMTU: Int?

/// backendExtraConfig
///
/// Extra configuration for Flannel backend.
///
/// The content of this field depends on the backend type used. The value of this field will be patched
/// into Flannel configuration ‘Backend’ section as-is.
backendExtraConfig: Dynamic?

/// resources
///
/// Resources configuration for Flannel main container.
resources: Dynamic?

/// extraArgs
///
/// Extra arguments for ‘flanneld’.
extraArgs: Listing<String>?

/// kubeNetworkPoliciesEnabled
///
/// Deploys kube-network-policies along with Flannel.
///
/// This enables Kubernetes Network Policies support in the cluster.
kubeNetworkPoliciesEnabled: Boolean?
