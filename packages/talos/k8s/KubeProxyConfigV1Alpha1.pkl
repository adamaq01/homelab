module k8s.KubeProxyConfigV1Alpha1

extends ".../TalosDocument.pkl"

apiVersion = "v1alpha1"

kind = "KubeProxyConfig"

/// enabled
///
/// Enable or disable kube-proxy deployment on cluster bootstrap.
///
/// Default is enabled.
enabled: Boolean?

/// image
///
/// The container image used in the kube-proxy manifest.
image: String

/// mode
///
/// description: | Proxy mode of kube-proxy.
///
/// The default value is ‘nftables’. It is not recommended to use any other value. values: - iptables -
/// ipvs - nftables
mode: String?

/// config
///
/// Provide configuration for the kube-proxy.
///
/// There is no need to specify kind and apiVersion fields (they will be set automatically), but the rest
/// of the configuration should be provided as is.
///
/// See https://kubernetes.io/docs/reference/config-api/kube-proxy-config.v1alpha1/ for the details of
/// the configuration schema.
config: Dynamic?

/// extraArgs
///
/// Extra arguments to supply to kube-proxy.
///
/// Please note that kube-proxy is configured with a configuration file, so most flags have no effect.
extraArgs: Mapping<String, String|Listing<String>>?

/// resources
///
/// Configure the kube-proxy resources.
resources: Dynamic?
