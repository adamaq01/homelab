/// NameserverConfig represents a single nameserver configuration.
///
/// This module was generated from JSON Schema from
/// <https://raw.githubusercontent.com/siderolabs/talos/v1.14.0/pkg/machinery/config/schemas/config.schema.json>.
module network.NameserverConfig

extends ".../TalosObject.pkl"

/// address
///
/// The IP address of the nameserver.
address: String(matches(Regex("^[0-9a-f.:]+$")))?

/// protocol
///
/// A DNS protocol to use.
///
/// The default protocol is plain DNS (Do53) (DNS over TCP/UDP). Set this to DoT to use DNS over TLS (RFC
/// 7858) on TCP port 853, or DoH to use DNS over HTTPS (RFC 8484) on TCP port 443 with the /dns-query
/// URL path. Both DoT and DoH deliver encrypted queries to this nameserver.
///
/// Note: encrypted DNS protocols require a correct system clock to validate certificates. If NTP is
/// configured with hostnames that need to be resolved through DoT/DoH, the boot may stall: NTP needs
/// DNS, and TLS needs valid time. Either rely on the hardware clock, configure NTP servers by IP, or
/// keep at least one plain-DNS fallback nameserver.
protocol: ("Do53"|"DoT"|"DoH")?

/// tlsServerName
///
/// TLS server name to validate the nameserver certificate against.
///
/// This field should be set if the protocol is set to DoT or DoH. The value is used both as the SNI sent
/// during the TLS handshake and as the name verified against the server certificate. For DoH, it is also
/// used as the host portion of the request URL (https://&lt;tlsServerName&gt;/dns-query) while the
/// connection itself is established to the configured address.
tlsServerName: String?
