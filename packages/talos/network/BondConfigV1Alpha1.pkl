/// BondConfig is a config document to create a bond (link aggregation) over a set of links.
///
/// This module was generated from JSON Schema from
/// <https://raw.githubusercontent.com/siderolabs/talos/v1.14.0/pkg/machinery/config/schemas/config.schema.json>.
module network.BondConfigV1Alpha1

extends ".../TalosDocument.pkl"

import "AddressConfig.pkl"
import "RouteConfig.pkl"

apiVersion = "v1alpha1"

kind = "BondConfig"

/// name
///
/// Name of the bond link (interface) to be created.
name: String

/// hardwareAddr
///
/// Override the hardware (MAC) address of the link.
hardwareAddr: String(matches(Regex("^[0-9a-f:]+$")))?

/// links
///
/// Names of the links (interfaces) on which the bond will be created. Link aliases can be used here as
/// well.
links: Listing<String>

/// bondMode
///
/// Bond mode.
bondMode: "balance-rr"|"active-backup"|"balance-xor"|"broadcast"|"802.3ad"|"balance-tlb"|"balance-alb"

/// miimon
///
/// Link monitoring frequency in milliseconds.
miimon: Int?

/// updelay
///
/// The time, in milliseconds, to wait before enabling a slave after a link recovery has been detected.
updelay: Int?

/// downdelay
///
/// The time, in milliseconds, to wait before disabling a slave after a link failure has been detected.
downdelay: Int?

/// useCarrier
///
/// Specifies whether or not miimon should use MII or ETHTOOL.
useCarrier: Boolean?

/// xmitHashPolicy
///
/// Selects the transmit hash policy to use for slave selection.
xmitHashPolicy: ("layer2"|"layer3+4"|"layer2+3"|"encap2+3"|"encap3+4")?

/// arpInterval
///
/// ARP link monitoring frequency in milliseconds.
arpInterval: Int?

/// arpIpTargets
///
/// The list of IPv4 addresses to use for ARP link monitoring when arpInterval is set. Maximum of 16
/// targets are supported.
arpIpTargets: Listing<String(matches(Regex("^[0-9a-f.:]+$")))>?

/// nsIp6Targets
///
/// The list of IPv6 addresses to use for NS link monitoring when arpInterval is set. Maximum of 16
/// targets are supported.
nsIp6Targets: Listing<String(matches(Regex("^[0-9a-f.:]+$")))>?

/// arpValidate
///
/// Specifies whether or not ARP probes and replies should be validated.
arpValidate: ("none"|"active"|"backup"|"all"|"filter"|"filter-active"|"filter-backup")?

/// arpAllTargets
///
/// Specifies whether ARP probes should be sent to any or all targets.
arpAllTargets: ("any"|"all")?

/// lacpRate
///
/// LACPDU frames periodic transmission rate.
lacpRate: ("slow"|"fast")?

/// failOverMac
///
/// Specifies whether active-backup mode should set all slaves to the same MAC address at enslavement,
/// when enabled, or perform special handling.
failOverMac: ("none"|"active"|"follow")?

/// adSelect
///
/// Aggregate selection policy for 802.3ad.
adSelect: ("stable"|"bandwidth"|"count")?

/// adActorSysPrio
///
/// Actor system priority for 802.3ad.
adActorSysPrio: Int?

/// adUserPortKey
///
/// User port key (upper 10 bits) for 802.3ad.
adUserPortKey: Int?

/// adLACPActive
///
/// Whether to send LACPDU frames periodically, defaults to “on” if mode is 802.3ad.
adLACPActive: ("on"|"off")?

/// primaryReselect
///
/// Policy under which the primary slave should be reselected.
primaryReselect: ("always"|"better"|"failure")?

/// resendIGMP
///
/// The number of times IGMP packets should be resent.
resendIGMP: Int?

/// minLinks
///
/// The minimum number of active links required for the bond to be considered active.
minLinks: Int?

/// lpInterval
///
/// The number of seconds between instances where the bonding driver sends learning packets to each
/// slave’s peer switch.
lpInterval: Int?

/// packetsPerSlave
///
/// The number of packets to transmit through a slave before moving to the next one.
packetsPerSlave: Int?

/// numPeerNotif
///
/// The number of peer notifications (gratuitous ARPs and unsolicited IPv6 Neighbor Advertisements) to be
/// issued after a failover event.
numPeerNotif: Int?

/// tlbLogicalLb
///
/// Whether dynamic shuffling of flows is enabled in tlb or alb mode.
tlbLogicalLb: Int?

/// allSlavesActive
///
/// Whether duplicate frames (received on inactive ports) should be dropped (0) or delivered (1).
allSlavesActive: Int?

/// peerNotifDelay
///
/// The delay, in milliseconds, between each peer notification.
peerNotifDelay: Int?

/// missedMax
///
/// The number of arpInterval monitor checks that must fail in order for an interface to be marked down
/// by the ARP monitor.
missedMax: Int?

/// up
///
/// Bring the link up or down.
///
/// If not specified, the link will be brought up.
up: Boolean?

/// mtu
///
/// Configure LinkMTU (Maximum Transmission Unit) for the link.
///
/// If not specified, the system default LinkMTU will be used (usually 1500).
mtu: Int?

/// addresses
///
/// Configure addresses to be statically assigned to the link.
addresses: Listing<AddressConfig>?

/// routes
///
/// Configure routes to be statically created via the link.
routes: Listing<RouteConfig>?

/// multicast
///
/// Set the multicast capability of the link.
multicast: Boolean?
