/// EthernetConfig is a config document to configure Ethernet interfaces.
///
/// This module was generated from JSON Schema from
/// <https://raw.githubusercontent.com/siderolabs/talos/v1.14.0/pkg/machinery/config/schemas/config.schema.json>.
module network.EthernetConfigV1Alpha1

extends ".../TalosDocument.pkl"

import "EthernetRingsConfig.pkl"
import "EthernetChannelsConfig.pkl"

apiVersion = "v1alpha1"

kind = "EthernetConfig"

/// name
///
/// Name of the link (interface).
name: String

/// features
///
/// Configuration for Ethernet features.
///
/// Set of features available and whether they can be enabled or disabled is driver specific. Use
/// talosctl get ethernetstatus &lt;link&gt; -o yaml to get the list of available features and their
/// current status.
features: Mapping<String(contains(Regex(".*"))), Boolean>?

/// rings
///
/// Configuration for Ethernet link rings.
///
/// This is similar to ethtool -G command.
rings: EthernetRingsConfig?

/// channels
///
/// Configuration for Ethernet link channels.
///
/// This is similar to ethtool -L command.
channels: EthernetChannelsConfig?

/// wakeOnLan
///
/// Wake-on-LAN modes to enable.
///
/// If this field is omitted, Wake-on-LAN configuration is not changed. An empty list disables
/// Wake-on-LAN.
///
/// This is similar to ethtool -s &lt;link&gt; wol &lt;options&gt; command.
wakeOnLan: Listing<String>?
