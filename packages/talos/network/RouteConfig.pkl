/// RouteConfig represents a network route configuration.
///
/// This module was generated from JSON Schema from
/// <https://raw.githubusercontent.com/siderolabs/talos/v1.14.0/pkg/machinery/config/schemas/config.schema.json>.
module network.RouteConfig

extends ".../TalosObject.pkl"

/// destination
///
/// The route’s destination as an address prefix.
///
/// If not specified, a default route will be created for the address family of the gateway.
destination: String(matches(Regex(#"^[0-9a-f.:]+/\d{1,3}$"#)))?

/// gateway
///
/// The route’s gateway (if empty, creates link scope route).
gateway: String(matches(Regex("^[0-9a-f.:]+$")))?

/// source
///
/// The route’s source address (optional).
source: String(matches(Regex("^[0-9a-f.:]+$")))?

/// metric
///
/// The optional metric for the route.
metric: Int?

/// mtu
///
/// The optional MTU for the route.
mtu: Int?

/// table
///
/// The routing table to use for the route.
///
/// If not specified, the main routing table will be used.
table: String?
