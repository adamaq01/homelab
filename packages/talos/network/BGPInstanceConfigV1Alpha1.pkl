/// BGPInstanceConfig configures a native BGP routing instance on the host.
///
/// This module was generated from JSON Schema from
/// <https://raw.githubusercontent.com/siderolabs/talos/v1.14.0/pkg/machinery/config/schemas/config.schema.json>.
module network.BGPInstanceConfigV1Alpha1

extends ".../TalosDocument.pkl"

import "BGPImportRoute.pkl"
import "BGPNeighborConfig.pkl"

apiVersion = "v1alpha1"

kind = "BGPInstanceConfig"

/// name
///
/// Name of the BGP routing instance.
name: String

/// vrf
///
/// Linux VRF link used by this routing instance. If unset, the default routing domain is used.
vrf: String?

/// localASN
///
/// Local autonomous system number for the BGP instance.
localASN: Int

/// routerID
///
/// BGP router-id. If not set, it is derived from the first advertised address.
routerID: String?

/// routeSource
///
/// Preferred source address set on routes installed from BGP (the kernel route src / RTA_PREFSRC,
/// equivalent to FRR’s ip protocol bgp route-map SETSRC). If not set, the kernel selects the source
/// address.
routeSource: String?

/// advertise
///
/// Names or aliases of the links whose addresses are originated into BGP as connected networks using
/// their configured prefix lengths.
advertise: Listing<String>?

/// multipath
///
/// Enable ECMP (multipath) for routes learned from multiple neighbors. Defaults to false.
multipath: Boolean?

/// maxPaths
///
/// Maximum number of ECMP next-hops to install. Zero uses the implementation default.
maxPaths: Int?

/// installRoutes
///
/// Install routes learned from BGP neighbors into the Linux routing table. Defaults to true. When false,
/// learned routes remain in this instance’s BGP RIB and can still be selected by importRoutes, but Talos
/// does not install them into the Linux FIB.
installRoutes: Boolean?

/// importRoutes
///
/// Selected routes to import from other BGP instances. Imports are one-way: matching best paths learned
/// from each source instance are preserved and advertised by this instance with its own next hop.
/// Locally originated and previously imported paths are not recursively imported. Selectors in a single
/// target instance must not overlap, giving each imported prefix one source.
importRoutes: Listing<BGPImportRoute>?

/// neighbors
///
/// BGP neighbors in this routing instance.
neighbors: Listing<BGPNeighborConfig>?
