/// HTTPProbeConfig is a config document to configure network HTTP connectivity probes.
///
/// This module was generated from JSON Schema from
/// <https://raw.githubusercontent.com/siderolabs/talos/v1.14.0/pkg/machinery/config/schemas/config.schema.json>.
module network.HTTPProbeConfigV1Alpha1

extends ".../TalosDocument.pkl"

apiVersion = "v1alpha1"

kind = "HTTPProbeConfig"

/// name
///
/// Name of the probe.
name: String

/// interval
///
/// Interval between probe attempts. Defaults to 1s.
interval: String(matches(Regex(#"^[-+]?(((\d+(\.\d*)?|\d*(\.\d+)+)([nuµm]?s|m|h))|0)+$"#)))?

/// failureThreshold
///
/// Number of consecutive failures for the probe to be considered failed after having succeeded. Defaults
/// to 0 (immediately fail on first failure).
failureThreshold: Int?

/// url
///
/// HTTP or HTTPS URL to probe. The probe succeeds if the server responds with a 2xx or 3xx status code.
/// Probe does not follow redirects.
url: String(contains(Regex("^(http|https)://")))

/// timeout
///
/// Timeout for the probe. Defaults to 10s.
timeout: String(matches(Regex(#"^[-+]?(((\d+(\.\d*)?|\d*(\.\d+)+)([nuµm]?s|m|h))|0)+$"#)))?
