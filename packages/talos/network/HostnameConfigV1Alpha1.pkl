/// HostnameConfig is a config document to configure the hostname: either a static hostname or an
/// automatically generated hostname.
///
/// This module was generated from JSON Schema from
/// <https://raw.githubusercontent.com/siderolabs/talos/v1.14.0/pkg/machinery/config/schemas/config.schema.json>.
module network.HostnameConfigV1Alpha1

extends ".../TalosDocument.pkl"

apiVersion = "v1alpha1"

kind = "HostnameConfig"

/// auto
///
/// A method to automatically generate a hostname for the machine.
///
/// There are two methods available: - stable - generates a stable hostname based on machine identity -
/// off - disables automatic hostname generation, Talos will wait for an external source to provide a
/// hostname (DHCP, cloud-init, etc).
///
/// Automatic hostnames have the lowest priority over any other hostname sources: DHCP, cloud-init, etc.
/// Conflicts with hostname field.
auto: ("stable"|"off")?

/// hostname
///
/// A static hostname to set for the machine.
///
/// This hostname has the highest priority over any other hostname sources: DHCP, cloud-init, etc.
/// Conflicts with auto field.
hostname: String?
