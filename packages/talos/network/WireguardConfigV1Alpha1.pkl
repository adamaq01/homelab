/// WireguardConfig is a config document to create and configure a Wireguard network link.
///
/// This module was generated from JSON Schema from
/// <https://raw.githubusercontent.com/siderolabs/talos/v1.14.0/pkg/machinery/config/schemas/config.schema.json>.
module network.WireguardConfigV1Alpha1

extends ".../TalosDocument.pkl"

import "WireguardPeer.pkl"
import "AddressConfig.pkl"
import "RouteConfig.pkl"

apiVersion = "v1alpha1"

kind = "WireguardConfig"

/// name
///
/// Name of the Wireguard link (interface).
name: String

/// privateKey
///
/// Specifies a private key configuration (base64 encoded). Can be generated by wg genkey.
privateKey: String

/// listenPort
///
/// Specifies a device’s listening port (UDP). If not specified, a random port will be chosen.
listenPort: Int?

/// firewallMark
///
/// Specifies a device’s firewall mark. Useful for advanced routing setups, marking packets originating
/// from this device.
firewallMark: Int?

/// peers
///
/// Specifies a list of peer configurations to apply to a device.
peers: Listing<WireguardPeer>?

/// up
///
/// Bring the link up or down.
///
/// If not specified, the link will be brought up.
up: Boolean?

/// mtu
///
/// Configure LinkMTU (Maximum Transmission Unit) for the link.
///
/// If not specified, the system default LinkMTU will be used (usually 1500).
mtu: Int?

/// addresses
///
/// Configure addresses to be statically assigned to the link.
addresses: Listing<AddressConfig>?

/// routes
///
/// Configure routes to be statically created via the link.
routes: Listing<RouteConfig>?

/// multicast
///
/// Set the multicast capability of the link.
multicast: Boolean?
