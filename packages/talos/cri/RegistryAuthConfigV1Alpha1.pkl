module cri.RegistryAuthConfigV1Alpha1

extends ".../TalosDocument.pkl"

apiVersion = "v1alpha1"

kind = "RegistryAuthConfig"

/// name
///
/// Registry endpoint to apply the authentication configuration to.
///
/// Registry endpoint is the hostname part of the endpoint URL, e.g. ‘my-mirror.local:5000’ for
/// ‘https://my-mirror.local:5000/v2/’.
///
/// The authentication configuration will apply to all image pulls for this registry endpoint, by Talos
