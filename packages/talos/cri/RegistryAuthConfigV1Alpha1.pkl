name: String

/// username
///
/// Username/password authentication.
username: String?

/// password
///
/// Username/password authentication.
password: String?

/// auth
///
/// Raw authentication string.
auth: String?

/// identityToken
///
/// Identity token authentication.
identityToken: String?
