/// Kubernetes authenticates with Vault by passing the ServiceAccount token stored in the named Secret
/// resource to the Vault server.
class AuthKubernetes {
  /// Path where the Kubernetes authentication backend is mounted in Vault, e.g: "kubernetes"
  ///
  /// Default if undefined: `"kubernetes"`
  mountPath: String

