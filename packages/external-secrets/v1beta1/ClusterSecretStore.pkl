extends "@k8s/K8sResource.pkl"

import "@k8s/apimachinery/pkg/apis/meta/v1/ObjectMeta.pkl"

fixed apiVersion: "external-secrets.io/v1beta1"

fixed kind: "ClusterSecretStore"

/// Standard object's metadata.
///
/// More info: <https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata>.
metadata: ObjectMeta?

/// SecretStoreSpec defines the desired state of SecretStore.
spec: Spec?

/// SecretStoreStatus defines the observed state of the SecretStore.
status: Status?

/// SecretStoreSpec defines the desired state of SecretStore.
class Spec {
  /// Used to constrain a ClusterSecretStore to specific namespaces. Relevant only to ClusterSecretStore.
  conditions: Listing<Condition>?

  /// Used to select the correct ESO controller (think: ingress.ingressClassName) The ESO controller is
  /// instantiated with a specific controller name and filters ES based on this property
  controller: String?

  /// Used to configure the provider. Only one provider may be set
  provider: Provider

  /// Used to configure store refresh interval in seconds. Empty or 0 will default to the controller
  /// config.
  refreshInterval: Int?

  /// Used to configure HTTP retries on failures.
  retrySettings: RetrySettings?
}

/// ClusterSecretStoreCondition describes a condition by which to choose namespaces to process
/// ExternalSecrets in for a ClusterSecretStore instance.
class Condition {
  /// Choose namespaces by using regex matching
  namespaceRegexes: Listing<String>?

  /// Choose namespace using a labelSelector
  namespaceSelector: NamespaceSelector?

  /// Choose namespaces by name
  namespaces: Listing<String(length.isBetween(1, 63), matches(Regex("^[a-z0-9]([-a-z0-9]*[a-z0-9])?$")))>?
}

/// Choose namespace using a labelSelector
class NamespaceSelector {
  /// matchExpressions is a list of label selector requirements. The requirements are ANDed.
  matchExpressions: Listing<MatchExpression>?

  /// matchLabels is a map of {key,value} pairs. A single {key,value} in the matchLabels map is
  /// equivalent to an element of matchExpressions, whose key field is "key", the operator is "In", and
  /// the values array contains only "value". The requirements are ANDed.
  matchLabels: Mapping<String, String>?
}

/// A label selector requirement is a selector that contains values, a key, and an operator that relates
/// the key and values.
class MatchExpression {
  /// key is the label key that the selector applies to.
  key: String

  /// operator represents a key's relationship to a set of values. Valid operators are In, NotIn, Exists
  /// and DoesNotExist.
  operator: String

  /// values is an array of string values. If the operator is In or NotIn, the values array must be
  /// non-empty. If the operator is Exists or DoesNotExist, the values array must be empty. This array is
  /// replaced during a strategic merge patch.
  values: Listing<String>?
}

/// Used to configure the provider. Only one provider may be set
class Provider {
  /// Akeyless configures this store to sync secrets using Akeyless Vault provider
  akeyless: Akeyless?

  /// Alibaba configures this store to sync secrets using Alibaba Cloud provider
  alibaba: Alibaba?

  /// AWS configures this store to sync secrets using AWS Secret Manager provider
  aws: Aws?

  /// AzureKV configures this store to sync secrets using Azure Key Vault provider
  azurekv: Azurekv?

  /// Beyondtrust configures this store to sync secrets using Password Safe provider.
  beyondtrust: Beyondtrust?

  /// BitwardenSecretsManager configures this store to sync secrets using BitwardenSecretsManager
  /// provider
  bitwardensecretsmanager: Bitwardensecretsmanager?

  /// Chef configures this store to sync secrets with chef server
  chef: Chef?

  /// CloudruSM configures this store to sync secrets using the Cloud.ru Secret Manager provider
  cloudrusm: Cloudrusm?

  /// Conjur configures this store to sync secrets using conjur provider
  conjur: Conjur?

  /// Delinea DevOps Secrets Vault
  /// https://docs.delinea.com/online-help/products/devops-secrets-vault/current
  delinea: Delinea?

  /// Device42 configures this store to sync secrets using the Device42 provider
  device42: Device42?

  /// Doppler configures this store to sync secrets using the Doppler provider
  doppler: Doppler?

  /// Fake configures a store with static key/value pairs
  fake: Fake?

  /// Fortanix configures this store to sync secrets using the Fortanix provider
  fortanix: Fortanix?

  /// GCPSM configures this store to sync secrets using Google Cloud Platform Secret Manager provider
  gcpsm: Gcpsm?

  /// Github configures this store to push GitHub Actions secrets using the GitHub API provider.
  github: Github?

  /// GitLab configures this store to sync secrets using GitLab Variables provider
  gitlab: Gitlab?

  /// IBM configures this store to sync secrets using IBM Cloud provider
  ibm: Ibm?

  /// Infisical configures this store to sync secrets using the Infisical provider
  infisical: Infisical?

  /// KeeperSecurity configures this store to sync secrets using the KeeperSecurity provider
  keepersecurity: Keepersecurity?

  /// Kubernetes configures this store to sync secrets using a Kubernetes cluster provider
  kubernetes: Kubernetes?

  /// Onboardbase configures this store to sync secrets using the Onboardbase provider
  onboardbase: Onboardbase?

  /// OnePassword configures this store to sync secrets using the 1Password Cloud provider
  onepassword: Onepassword?

  /// Oracle configures this store to sync secrets using Oracle Vault provider
  oracle: Oracle?

  /// PassboltProvider defines configuration for the Passbolt provider.
  passbolt: Passbolt?

  /// PasswordDepotProvider configures a store to sync secrets with a Password Depot instance.
  passworddepot: Passworddepot?

  /// Previder configures this store to sync secrets using the Previder provider
  previder: Previder?

  /// Pulumi configures this store to sync secrets using the Pulumi provider
  pulumi: Pulumi?

  /// Scaleway configures this store to sync secrets using the Scaleway provider.
  scaleway: Scaleway?

  /// SecretServer configures this store to sync secrets using SecretServer provider
  /// https://docs.delinea.com/online-help/secret-server/start.htm
  secretserver: Secretserver?

  /// Senhasegura configures this store to sync secrets using senhasegura provider
  senhasegura: Senhasegura?

  /// Vault configures this store to sync secrets using the HashiCorp Vault provider.
  vault: Vault?

  /// Webhook configures this store to sync secrets using a generic templated webhook
  webhook: Webhook?

  /// YandexCertificateManager configures this store to sync secrets using Yandex Certificate Manager
  /// provider
  yandexcertificatemanager: Yandexcertificatemanager?

  /// YandexLockbox configures this store to sync secrets using Yandex Lockbox provider
  yandexlockbox: Yandexlockbox?
}

/// Akeyless configures this store to sync secrets using Akeyless Vault provider
class Akeyless {
