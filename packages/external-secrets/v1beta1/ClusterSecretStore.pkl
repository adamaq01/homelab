  namespace: String(length.isBetween(1, 63), matches(Regex("^[a-z0-9]([-a-z0-9]*[a-z0-9])?$")))?
}

/// Optional SecretRef that refers to a key in a Secret resource containing JWT token to authenticate
/// with Vault using the JWT/OIDC authentication method.
class AuthJwtSecretRef {
  /// A key in the referenced Secret. Some instances of this field may be defaulted, in others it may be
  /// required.
  key: String(length.isBetween(1, 253), matches(Regex("^[-._a-zA-Z0-9]+$")))?

  /// The name of the Secret resource being referred to.
  name: String(length.isBetween(1, 253), matches(Regex(#"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"#)))?

