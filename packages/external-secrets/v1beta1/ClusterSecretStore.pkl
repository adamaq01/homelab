  /// SecretsManager defines how the provider behaves when interacting with AWS SecretsManager
  secretsManager: SecretsManager?

  /// Service defines which service should be used to fetch the secrets
  service: "SecretsManager"|"ParameterStore"

  /// AWS STS assume role session tags
  sessionTags: Listing<SessionTag>?

  /// AWS STS assume role transitive session tags. Required when multiple rules are used with the
  /// provider
  transitiveTagKeys: Listing<String>?
}

