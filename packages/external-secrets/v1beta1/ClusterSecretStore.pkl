}

/// Webhook configures this store to sync secrets using a generic templated webhook
class Webhook {
  /// Auth specifies a authorization protocol. Only one protocol may be set.
  auth: WebhookAuth?

  /// Body
  body: String?

  /// PEM encoded CA bundle used to validate webhook server certificate. Only used if the Server URL is
  /// using HTTPS protocol. This parameter is ignored for plain HTTP protocol connection. If not set the
  /// system root certificates are used to validate the TLS connection.
  caBundle: String?

  /// The provider for the CA bundle to use to validate webhook server certificate.
  caProvider: WebhookCaProvider?

  /// Headers
  headers: Mapping<String, String>?

  /// Webhook Method
  method: String?

  /// Result formatting
  result: Result

  /// Secrets to fill in templates These secrets will be passed to the templating function as key value
  /// pairs under the given name
  secrets: Listing<Secret>?

  /// Timeout
  timeout: String?

  /// Webhook url to call
  url: String
}

/// Auth specifies a authorization protocol. Only one protocol may be set.
class WebhookAuth {
  /// NTLMProtocol configures the store to use NTLM for auth
  ntlm: Ntlm?
}

/// NTLMProtocol configures the store to use NTLM for auth
class Ntlm {
  /// SecretKeySelector is a reference to a specific 'key' within a Secret resource. In some instances,
  /// `key` is a required field.
  passwordSecret: YandexlockboxCaProviderCertSecretRef

  /// SecretKeySelector is a reference to a specific 'key' within a Secret resource. In some instances,
  /// `key` is a required field.
  usernameSecret: YandexlockboxCaProviderCertSecretRef
}

/// The provider for the CA bundle to use to validate webhook server certificate.
class WebhookCaProvider {
  /// The key where the CA certificate can be found in the Secret or ConfigMap.
  key: String(length.isBetween(1, 253), matches(Regex("^[-._a-zA-Z0-9]+$")))?

  /// The name of the object located at the provider type.
  name: String(length.isBetween(1, 253), matches(Regex(#"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"#)))

  /// The namespace the Provider type is in.
  namespace: String(length.isBetween(1, 63), matches(Regex("^[a-z0-9]([-a-z0-9]*[a-z0-9])?$")))?

  /// The type of provider to use such as "Secret", or "ConfigMap".
  type: "Secret"|"ConfigMap"
}

/// Result formatting
class Result {
  /// Json path of return value
  jsonPath: String?
}

/// WebhookSecret defines a secret to be used in webhook templates.
class Secret {
  /// Name of this secret in templates
  name: String

  /// Secret ref to fill in credentials
  secretRef: SecretSecretRef
}

/// Secret ref to fill in credentials
class SecretSecretRef {
  /// A key in the referenced Secret. Some instances of this field may be defaulted, in others it may be
  /// required.
  key: String(length.isBetween(1, 253), matches(Regex("^[-._a-zA-Z0-9]+$")))?

  /// The name of the Secret resource being referred to.
  name: String(length.isBetween(1, 253), matches(Regex(#"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"#)))?

  /// The namespace of the Secret resource being referred to. Ignored if referent is not cluster-scoped,
  /// otherwise defaults to the namespace of the referent.
  namespace: String(length.isBetween(1, 63), matches(Regex("^[a-z0-9]([-a-z0-9]*[a-z0-9])?$")))?
}

/// YandexCertificateManager configures this store to sync secrets using Yandex Certificate Manager
/// provider
class Yandexcertificatemanager {
  /// Yandex.Cloud API endpoint (e.g. 'api.cloud.yandex.net:443')
  apiEndpoint: String?

  /// Auth defines the information necessary to authenticate against Yandex Certificate Manager
  auth: YandexcertificatemanagerAuth

  /// The provider for the CA bundle to use to validate Yandex.Cloud server certificate.
  caProvider: YandexlockboxCaProvider?
}

/// Auth defines the information necessary to authenticate against Yandex Certificate Manager
class YandexcertificatemanagerAuth {
  /// The authorized key used for authentication
  authorizedKeySecretRef: AuthAuthorizedKeySecretRef?
}

/// The authorized key used for authentication
class AuthAuthorizedKeySecretRef {
  /// A key in the referenced Secret. Some instances of this field may be defaulted, in others it may be
  /// required.
  key: String(length.isBetween(1, 253), matches(Regex("^[-._a-zA-Z0-9]+$")))?

  /// The name of the Secret resource being referred to.
  name: String(length.isBetween(1, 253), matches(Regex(#"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"#)))?

  /// The namespace of the Secret resource being referred to. Ignored if referent is not cluster-scoped,
  /// otherwise defaults to the namespace of the referent.
  namespace: String(length.isBetween(1, 63), matches(Regex("^[a-z0-9]([-a-z0-9]*[a-z0-9])?$")))?
}

/// The provider for the CA bundle to use to validate Yandex.Cloud server certificate.
class YandexlockboxCaProvider {
  /// SecretKeySelector is a reference to a specific 'key' within a Secret resource. In some instances,
  /// `key` is a required field.
  certSecretRef: YandexlockboxCaProviderCertSecretRef?
}

/// YandexLockbox configures this store to sync secrets using Yandex Lockbox provider
class Yandexlockbox {
  /// Yandex.Cloud API endpoint (e.g. 'api.cloud.yandex.net:443')
  apiEndpoint: String?

  /// Auth defines the information necessary to authenticate against Yandex Lockbox
  auth: YandexlockboxAuth

  /// The provider for the CA bundle to use to validate Yandex.Cloud server certificate.
  caProvider: YandexlockboxCaProvider?
}

/// Auth defines the information necessary to authenticate against Yandex Lockbox
class YandexlockboxAuth {
  /// The authorized key used for authentication
  authorizedKeySecretRef: AuthAuthorizedKeySecretRef?
}

/// Used to configure HTTP retries on failures.
class RetrySettings {
  /// MaxRetries is the maximum number of retry attempts.
  maxRetries: Int?

  /// RetryInterval is the interval between retry attempts.
  retryInterval: String?
}

/// SecretStoreStatus defines the observed state of the SecretStore.
class Status {
  /// SecretStoreCapabilities defines the possible operations a SecretStore can do.
  capabilities: String?

  conditions: Listing<StatusCondition>?
}

/// SecretStoreStatusCondition defines the observed condition of the SecretStore.
class StatusCondition {
  lastTransitionTime: String?

  message: String?

  reason: String?

  status: String

  /// SecretStoreConditionType represents the condition type of the SecretStore.
  type: String
}
