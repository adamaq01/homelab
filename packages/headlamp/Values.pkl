  enabled: Boolean?

  /// Set to true if the external secret contains an OIDC_SCOPES key
  hasScopes: Boolean?
}

/// Bundled (static) plugins shipped in the Headlamp image, such as the Prometheus plugin
class StaticPlugins {
  /// Serve the bundled static plugins. Set to false to disable them (e.g. the "Show Prometheus metrics"
  /// button)
  ///
  /// Default if undefined: `true`
  enabled: Boolean?
}

/// Experimental/alpha Cluster Inventory configuration
class ClusterInventory {
  /// Enable experimental/alpha Cluster Inventory discovery
  ///
  /// Default if undefined: `false`
  enabled: Boolean?

  /// Experimental/alpha Cluster Inventory access providers config
  ///
  /// Default if undefined: `{}`
  accessProvidersConfig: Dynamic?

  /// Kubernetes image volumes that provide experimental/alpha Cluster Inventory access provider binaries
  ///
  /// Default if undefined: `{}`
  plugins: Listing<Plugin>?

  /// Kubernetes label selector used to filter experimental/alpha ClusterProfile resources
  ///
  /// Default if undefined: `"!headlamp.dev/ignore"`
  labelSelector: String?

  /// Namespaces watched for experimental/alpha ClusterProfile resources. Empty uses the Headlamp pod
  /// namespace for in-cluster roots and the kubeconfig context namespace for kubeconfig roots; ["*"]
  /// watches all and requires equivalent cluster-wide RBAC permissions
  ///
  /// Default if undefined: `{}`
  namespaces: (
    Listing<"*">(length <= 1)
    |Listing<String(length.isBetween(1, 63), matches(Regex("^[a-z0-9]([-a-z0-9]*[a-z0-9])?$")))>)(isDistinct)?

  /// Override the experimental/alpha Cluster Inventory root reconcile interval. Empty uses the Headlamp
  /// default
  ///
  /// Default if undefined: `""`
  rootReconcileInterval: String?

  /// Override the experimental/alpha Cluster Inventory no-CRD cache TTL. Empty uses the Headlamp default
  ///
  /// Default if undefined: `""`
  noCRDCacheTTL: String?
}

class Plugin {
  /// DNS label name of the plugin image volume
  name: String(length <= 63, matches(Regex("^[a-z0-9]([-a-z0-9]*[a-z0-9])?$")))

  /// Image reference for the plugin image volume
  image: String

  /// Absolute read-only mount path for the plugin image volume
  mountPath: String(contains(Regex("^/")))
}

