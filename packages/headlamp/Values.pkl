  livenessProbe: LivenessProbe?

  /// Readiness probe settings
  readinessProbe: ReadinessProbe?
}

/// Liveness probe settings
class LivenessProbe {
  /// Initial delay in seconds before starting liveness probe
  ///
  /// Default if undefined: `0`
  initialDelaySeconds: Int(isPositive)?

  /// Period in seconds between liveness probe checks
  ///
  /// Default if undefined: `10`
  periodSeconds: Int(this >= 1)?

  /// Timeout in seconds for liveness probe
  ///
  /// Default if undefined: `1`
  timeoutSeconds: Int(this >= 1)?

  /// Minimum consecutive successes for the probe to be considered successful (must be 1 for liveness
  /// probes per Kubernetes API)
  ///
  /// Default if undefined: `1`
  successThreshold: Int(isBetween(1, 1), this == 1)?

  /// Minimum consecutive failures for the probe to be considered failed
  ///
  /// Default if undefined: `3`
  failureThreshold: Int(this >= 1)?
}

/// Readiness probe settings
class ReadinessProbe {
  /// Initial delay in seconds before starting readiness probe
  ///
  /// Default if undefined: `0`
  initialDelaySeconds: Int(isPositive)?

  /// Period in seconds between readiness probe checks
  ///
  /// Default if undefined: `10`
  periodSeconds: Int(this >= 1)?

  /// Timeout in seconds for readiness probe
  ///
  /// Default if undefined: `1`
  timeoutSeconds: Int(this >= 1)?

  /// Minimum consecutive successes for the probe to be considered successful
  ///
  /// Default if undefined: `1`
  successThreshold: Int(this >= 1)?

  /// Minimum consecutive failures for the probe to be considered failed
  ///
  /// Default if undefined: `3`
  failureThreshold: Int(this >= 1)?
}

class HostAlias {
  /// IP address the hostnames resolve to
  ip: String

  /// Hostnames that resolve to the given IP
  hostnames: Listing<String>
}
