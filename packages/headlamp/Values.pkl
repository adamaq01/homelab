class PodDisruptionBudget {
  /// Enable PodDisruptionBudget. See: https://kubernetes.io/docs/concepts/workloads/pods/disruptions/
  ///
  /// Default if undefined: `false`
  enabled: Boolean?

  /// Minimum number/percentage of pods that should remain scheduled. When it's set, maxUnavailable must
  /// be disabled by `maxUnavailable: null`
  ///
  /// Default if undefined: `0`
  minAvailable: (Null|Int(isPositive)|String(matches(Regex(#"^([0-9]+%?|[0-9]*\.[0-9]+%)$"#))))?

  /// Maximum number/percentage of pods that may be made unavailable
  maxUnavailable: (Null|Int(isPositive)|String(matches(Regex(#"^([0-9]+%?|[0-9]*\.[0-9]+%)$"#))))?

  /// How are unhealthy, but running, pods counted for eviction
  unhealthyPodEvictionPolicy: (Null|"IfHealthyBudget"|"AlwaysAllow")?
}

/// Probe configuration for liveness and readiness checks
class Probes {
  /// Scheme for probes (HTTP or HTTPS). Set to HTTPS when TLS is enabled at the backend server.
  ///
  /// Default if undefined: `"HTTP"`
  scheme: ("HTTP"|"HTTPS")?

