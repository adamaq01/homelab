  /// set: prometheus.prometheusSpec.serviceMonitorSelectorNilUsesHelmValues=false
  enabled: Boolean?

  /// If true, use metric labels from the Login UI instead of relabeling them to match Prometheus
  /// conventions.
  honorLabels: Boolean?

  /// If true, preserve original scrape timestamps from the Login UI instead of using Prometheus server
  /// time.
  honorTimestamps: Boolean?

  /// ([]RelabelConfig) Relabeling rules applied to individual metrics. Use to rename metrics, drop
  /// expensive metrics, or modify metric labels.
  metricRelabellings: Listing?

  /// Namespace where the ServiceMonitor should be created. If null, uses the release namespace. Set this
  /// if Prometheus watches a specific namespace.
  namespace: String?

  /// HTTP proxy URL for scraping. Use if Prometheus needs to access the Login UI through a proxy.
  proxyUrl: String?

  /// ([]RelabelConfig) Relabeling rules applied before ingestion. Use to modify, filter, or drop labels
  /// before metrics are stored.
  relabellings: Listing?

  /// HTTP scheme to use for scraping. Set to "https" if the Login UI has internal TLS enabled. If null,
  /// defaults to "http".
  scheme: String?

  /// How often Prometheus should scrape metrics from the Login UI. If null, uses Prometheus's default
  /// scrape interval (typically 30s).
  scrapeInterval: String?

  /// Timeout for scrape requests. If null, uses Prometheus's default timeout. Should be less than
  /// scrapeInterval.
  scrapeTimeout: String?

  /// TLS configuration for scraping HTTPS endpoints. Configure this if the Login UI has internal TLS
  /// enabled and you need to verify certificates.
  tlsConfig: Dynamic?
}

