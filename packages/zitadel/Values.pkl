class Login {
  /// Affinity rules for pod scheduling. Use for advanced pod placement strategies like co-locating pods
  /// or spreading across zones. Ref:
  /// https://kubernetes.io/docs/concepts/scheduling-eviction/assign-pod-node/#affinity-and-anti-affinity
  affinity: Dynamic?

