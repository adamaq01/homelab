amends "pkl:Project"

evaluatorSettings {
  externalResourceReaders {
    ["talos-factory+http"] {
      executable = "pkl-reader-talos-factory"
    }
    ["talos-factory+https"] {
      executable = "pkl-reader-talos-factory"
    }
  }
}

