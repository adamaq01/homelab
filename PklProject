  ["k8s"] {
    uri = "package://pkg.pkl-lang.org/pkl-k8s/k8s@1.4.1"
  }
  ["deepToTyped"] {
    uri = "package://pkg.pkl-lang.org/pkl-pantry/pkl.experimental.deepToTyped@1.2.1"
  }
  ["argocd"] = import("packages/argocd/PklProject")
  ["talos"] = import("packages/talos/PklProject")
  ["talos-factory"] = import("packages/talos-factory/PklProject")
  ["manifest"] = import("packages/manifest/PklProject")
  ["metallb"] = import("packages/metallb/PklProject")
  ["gateway-api"] = import("packages/gateway-api/PklProject")
  ["traefik-crds"] = import("packages/traefik-crds/PklProject")
  ["cert-manager"] = import("packages/cert-manager/PklProject")
  ["traefik"] = import("packages/traefik/PklProject")
  ["external-dns"] = import("packages/external-dns/PklProject")
  ["external-secrets"] = import("packages/external-secrets/PklProject")
  ["openbao"] = import("packages/openbao/PklProject")
  ["cloudnative-pg"] = import("packages/cloudnative-pg/PklProject")
  ["node-feature-discovery"] = import("packages/node-feature-discovery/PklProject")
  ["intel-device-plugins"] = import("packages/intel-device-plugins/PklProject")
}
