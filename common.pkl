open module common

repoURL: String = "https://github.com/adamaq01/homelab.git"
rootDomain: String = "adamaq01.fr"
clusterName: String = "pegasus"

/// LAN domain for literal hosts (nodes, the NAS, ...), resolved via the router's own DNS.
lanDomain: String = "home.\(rootDomain)"
nasDomain: String = "nas.\(lanDomain)"
k8sControlPlaneEndpoint: String = "https://pegasus.\(lanDomain):6443"

/// Wildcard domain for Kubernetes ingress, scoped separately from [lanDomain] by cluster name so a
/// wildcard DNS record for it can never collide with a literal LAN host's own hostname. Default/
/// canonical ingress domain, every ingress-facing hostname should also be reachable under
/// [ingressAliasDomain].
ingressDomain: String = "\(clusterName).\(lanDomain)"

/// Shorter alias for [ingressDomain], kept purely for convenience since no global service collides
/// with it today.
ingressAliasDomain: String = "\(clusterName).\(rootDomain)"

/// CIDR every Pod IP is drawn from cluster-wide.
podSubnet: String = "10.244.0.0/16"

/// CIDR every node's own LAN address is drawn from.
nodeSubnet: String = "192.168.2.0/24"
